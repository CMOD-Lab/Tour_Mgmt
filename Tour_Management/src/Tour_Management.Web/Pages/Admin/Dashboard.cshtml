@page
@model Tour_Management.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>
    <span class="badge bg-danger fs-6">Admin</span>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card bg-primary text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalTours</h2>
                    <p class="mb-0">Total Tours</p>
                </div>
                <i class="bi bi-map display-4 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Tours/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>Manage Tours
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-success text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalBookings</h2>
                    <p class="mb-0">Total Bookings</p>
                </div>
                <i class="bi bi-calendar-check display-4 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Bookings/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>View All Bookings
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-info text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalUsers</h2>
                    <p class="mb-0">Registered Users</p>
                </div>
                <i class="bi bi-people display-4 opacity-50"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Users/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>Manage Users
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Recent Bookings</h5>
                <a asp-page="/Bookings/Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentBookings.Any())
                {
                    <p class="p-3 text-muted">No bookings yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tour</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.RecentBookings)
                                {
                                    <tr>
                                        <td>@b.TourName</td>
                                        <td>@b.FirstName</td>
                                        <td>@b.CreatedDate.ToString("dd MMM")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-map me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Tours/Create" class="btn btn-success">
                        <i class="bi bi-plus-circle me-2"></i>Add New Tour
                    </a>
                    <a asp-page="/Bookings/Index" class="btn btn-primary">
                        <i class="bi bi-calendar-check me-2"></i>View All Bookings
                    </a>
                    <a asp-page="/Users/Index" class="btn btn-info text-white">
                        <i class="bi bi-people me-2"></i>Manage Users
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
