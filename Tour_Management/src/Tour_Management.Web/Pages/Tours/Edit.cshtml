@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Tour</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                    </div>
                }
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Input.TourId" />

                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Days" class="form-label"></label>
                            <input asp-for="Input.Days" class="form-control" type="number" min="1" max="99" />
                            <span asp-validation-for="Input.Days" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Locations" class="form-label"></label>
                        <input asp-for="Input.Locations" class="form-control" />
                        <span asp-validation-for="Input.Locations" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.TourInfo" class="form-label"></label>
                        <textarea asp-for="Input.TourInfo" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.Input.ExistingPicturePath))
                        {
                            <p class="mb-1">Current picture: <strong>@Model.Input.ExistingPicturePath</strong></p>
                            <img src="~/tour-pics/@Model.Input.ExistingPicturePath" class="img-thumbnail mb-2" style="max-height:100px;" alt="Current picture" />
                        }
                        <label asp-for="Input.PictureFile" class="form-label">New Picture (leave empty to keep current)</label>
                        <input asp-for="Input.PictureFile" class="form-control" type="file" accept="image/*" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-circle me-1"></i>Save Changes
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
