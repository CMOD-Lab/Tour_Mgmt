@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>Tour not found.
        <a asp-page="Index" class="alert-link">Back to Tours</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
            {
                <img src="~/tour-pics/@Model.Tour.PicturePath" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:300px;">
                    <i class="bi bi-image text-secondary display-1"></i>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1>@Model.Tour.TourName</h1>
            <hr />
            <dl class="row">
                <dt class="col-sm-4"><i class="bi bi-geo-alt me-1"></i>Destination</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>

                <dt class="col-sm-4"><i class="bi bi-calendar me-1"></i>Duration</dt>
                <dd class="col-sm-8">@Model.Tour.Days days</dd>

                <dt class="col-sm-4"><i class="bi bi-currency-rupee me-1"></i>Price</dt>
                <dd class="col-sm-8 fw-bold text-primary fs-5">₹@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-4"><i class="bi bi-map me-1"></i>Locations</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>

                <dt class="col-sm-4"><i class="bi bi-info-circle me-1"></i>Tour Info</dt>
                <dd class="col-sm-8">@Model.Tour.TourInfo</dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success btn-lg">
                    <i class="bi bi-cart-plus me-2"></i>Book This Tour
                </a>
                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Tours
                </a>
                @if (Model.IsAdmin)
                {
                    <a asp-page="Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                }
            </div>
        </div>
    </div>
}
