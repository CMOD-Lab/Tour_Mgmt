@page
@model Tour_Management.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron bg-primary text-white p-5 rounded mb-4">
    <h1 class="display-4"><i class="bi bi-airplane-fill me-3"></i>Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your dream vacation today!</p>
    <hr class="my-4 border-light" />
    <a class="btn btn-light btn-lg me-2" asp-page="/Tours/Index">
        <i class="bi bi-map me-2"></i>Browse Tours
    </a>
    @if (Model.UserEmail == null)
    {
        <a class="btn btn-outline-light btn-lg" asp-page="/Users/Register">
            <i class="bi bi-person-plus me-2"></i>Register Now
        </a>
    }
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-map display-4 text-primary mb-3"></i>
                <h5 class="card-title">Explore Tours</h5>
                <p class="card-text">Browse our wide selection of tour packages to destinations across India and beyond.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check display-4 text-success mb-3"></i>
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Book your favorite tour in just a few clicks. Simple, fast, and secure.</p>
                @if (Model.UserEmail != null)
                {
                    <a asp-page="/Bookings/MyBookings" class="btn btn-success">My Bookings</a>
                }
                else
                {
                    <a asp-page="/Users/Login" class="btn btn-success">Login to Book</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-person-circle display-4 text-info mb-3"></i>
                <h5 class="card-title">Your Profile</h5>
                <p class="card-text">Manage your account, view your bookings, and update your personal information.</p>
                @if (Model.UserEmail != null)
                {
                    <a asp-page="/Users/Profile" class="btn btn-info text-white">View Profile</a>
                }
                else
                {
                    <a asp-page="/Users/Register" class="btn btn-info text-white">Create Account</a>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.FeaturedTours.Any())
{
    <h2 class="mt-4 mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Featured Tours</h2>
    <div class="row">
        @foreach (var tour in Model.FeaturedTours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/tour-pics/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <i class="bi bi-image text-white display-4"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted"><i class="bi bi-geo-alt me-1"></i>@tour.Place</p>
                        <p class="card-text"><i class="bi bi-calendar me-1"></i>@tour.Days days</p>
                        <p class="card-text fw-bold text-primary">₹@tour.Price.ToString("N2")</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm ms-1">
                            <i class="bi bi-cart-plus me-1"></i>Book Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
