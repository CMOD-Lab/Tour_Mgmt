@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-x-circle me-2"></i>Cancel Booking</h4>
            </div>
            <div class="card-body">
                @if (Model.Booking == null)
                {
                    <div class="alert alert-warning">Booking not found.</div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Are you sure you want to cancel this booking?
                    </div>
                    <dl class="row">
                        <dt class="col-sm-4">Tour</dt>
                        <dd class="col-sm-8">@Model.Booking.TourName</dd>
                        <dt class="col-sm-4">Destination</dt>
                        <dd class="col-sm-8">@Model.Booking.Place</dd>
                        <dt class="col-sm-4">Booked On</dt>
                        <dd class="col-sm-8">@Model.Booking.CreatedDate.ToString("dd MMM yyyy")</dd>
                    </dl>
                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Booking.BookingId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-1"></i>Yes, Cancel Booking
                            </button>
                            <a asp-page="MyBookings" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Keep Booking
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
