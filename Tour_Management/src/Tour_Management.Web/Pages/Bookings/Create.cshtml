@page
@model Tour_Management.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a Tour";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-cart-plus me-2"></i>Book a Tour</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                    </div>
                }
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" readonly />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" readonly />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" placeholder="Your email address" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Your first name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Confirm Booking
                        </button>
                        <a asp-page="/Tours/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
