@page
@model Tour_Management.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-calendar-check me-2"></i>My Bookings</h1>
    <a asp-page="/Tours/Index" class="btn btn-primary">
        <i class="bi bi-map me-1"></i>Browse More Tours
    </a>
</div>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>You have no bookings yet.
        <a asp-page="/Tours/Index" class="alert-link">Browse tours</a> to book one!
    </div>
}
else
{
    <div class="row">
        @foreach (var booking in Model.Bookings)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-airplane me-2"></i>@booking.TourName</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Destination</dt>
                            <dd class="col-sm-8">@booking.Place</dd>
                            <dt class="col-sm-4">Booked By</dt>
                            <dd class="col-sm-8">@booking.FirstName</dd>
                            <dt class="col-sm-4">Booking Date</dt>
                            <dd class="col-sm-8">@booking.CreatedDate.ToString("dd MMM yyyy")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <a asp-page="Details" asp-route-id="@booking.BookingId" class="btn btn-info btn-sm text-white">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>
                        <a asp-page="Delete" asp-route-id="@booking.BookingId" class="btn btn-danger btn-sm">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
