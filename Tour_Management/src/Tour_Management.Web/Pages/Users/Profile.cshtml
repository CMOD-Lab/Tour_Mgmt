@page
@model Tour_Management.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@if (Model.User == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>Profile not found. Please <a asp-page="Login">login</a>.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-1 text-primary mb-3"></i>
                    <h4>@Model.User.FullName</h4>
                    <p class="text-muted">@Model.User.Email</p>
                    <a asp-page="Edit" asp-route-email="@Model.User.Email" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit Profile
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personal Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.User.Email</dd>
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.User.FullName</dd>
                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.User.Gender</dd>
                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.User.DateOfBirth.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.User.Street, @Model.User.City, @Model.User.State</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>My Bookings</h5>
                    <a asp-page="/Bookings/MyBookings" class="btn btn-primary btn-sm">View All</a>
                </div>
                <div class="card-body">
                    @if (!Model.RecentBookings.Any())
                    {
                        <p class="text-muted">No bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to book one!</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Tour</th>
                                        <th>Place</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.RecentBookings)
                                    {
                                        <tr>
                                            <td>@booking.TourName</td>
                                            <td>@booking.Place</td>
                                            <td>@booking.CreatedDate.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
