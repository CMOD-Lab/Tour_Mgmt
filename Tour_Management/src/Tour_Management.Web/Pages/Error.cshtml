@page
@model Tour_Management.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-3"></i>
        <h1 class="display-4">Oops!</h1>
        <p class="lead">An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-page="/Index" class="btn btn-primary mt-3">
            <i class="bi bi-house me-1"></i>Go Home
        </a>
    </div>
</div>
