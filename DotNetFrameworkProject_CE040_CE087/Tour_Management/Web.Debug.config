<?xml version="1.0" encoding="utf-8"?>
<!--
  MIGRATION NOTE (cr-dotnet-0010):
  Web.config transformation files (Web.Debug.config, Web.Release.config) have been
  replaced by ASP.NET Core's environment-based configuration system.

  Instead of build-time Web.config transformations, use:
    - appsettings.Development.json for development-specific overrides
    - Environment variables (ASPNETCORE_ENVIRONMENT=Development) to select the environment
    - CONNECTIONSTRINGS__DBCONNECTION environment variable for the connection string

  This enables runtime configuration without rebuilding, which is required for
  cloud deployment pipelines on Azure Container Apps.

  The xdt:Transform directives below are retained for reference only and are
  no longer processed by the migrated ASP.NET Core application.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Development environment overrides are now in appsettings.Development.json.
    Set ASPNETCORE_ENVIRONMENT=Development to activate development configuration.
  -->
</configuration>
