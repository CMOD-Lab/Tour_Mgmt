<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Readiness Fix: cr-dotnet-0010 - Web.config Transformations
  Remediation: Replace Web.config transformations with environment-based configuration
  
  This Web.Debug.config transformation file is superseded by environment-based configuration.
  Instead of using build-time transformations, use:
  
  1. Environment variables (preferred for cloud):
     - Set TOURDB_CONNECTION_STRING in Azure App Service Configuration
     - Set ASPNET_ENVIRONMENT=Development for local development
  
  2. appsettings.{Environment}.json pattern (for ASP.NET Core migration):
     - appsettings.json (base configuration)
     - appsettings.Development.json (development overrides)
     - appsettings.Production.json (production overrides)
  
  This file is retained for backward compatibility but environment variables
  take precedence over all Web.config values at runtime.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Debug mode is controlled by ASPNET_ENVIRONMENT environment variable in cloud deployments -->
    <compilation xdt:Transform="SetAttributes(debug)" debug="true" />
  </system.web>
  <!--
    Cloud Readiness: For local development, override connection string via environment variable:
    Windows: setx TOURDB_CONNECTION_STRING "Data Source=(LocalDB)\MSSQLLocalDB;..."
    Linux/macOS: export TOURDB_CONNECTION_STRING="Server=localhost;..."
    
    Do NOT use this transformation file for cloud deployments.
    Use Azure App Service Application Settings or Key Vault references instead.
  -->
</configuration>
