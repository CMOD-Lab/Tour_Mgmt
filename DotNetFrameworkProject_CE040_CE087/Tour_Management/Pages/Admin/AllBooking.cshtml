@page
@model Tour_Management.Pages.Admin.AllBookingModel
@{
    ViewData["Title"] = "All Bookings";
}

<div class="page-header">
    <h1>All Bookings</h1>
</div>

<div class="container">
    @if (Model.Bookings.Any())
    {
        <table style="width:100%; color:white; border-collapse:collapse;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Email</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.Email</td>
                        <td>@booking.FirstName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No bookings found.</p>
    }
</div>
