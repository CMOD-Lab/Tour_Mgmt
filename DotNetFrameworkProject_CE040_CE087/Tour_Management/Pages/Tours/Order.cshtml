@page
@model Tour_Management.Pages.Tours.OrderModel
@{
    ViewData["Title"] = "Book Tour";
}

<div class="page-header">
    <h1>Book a Tour</h1>
</div>

<div class="container">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="@(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }

    <div class="row">
        <div class="form-horizontal col-md-7">
            <form method="post">
                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.TourName">Tour Name</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.TourName" class="form-control" required />
                        <span asp-validation-for="Input.TourName" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.City">City</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.City" class="form-control" required />
                        <span asp-validation-for="Input.City" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Email">Email</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Email" class="form-control" type="email" required />
                        <span asp-validation-for="Input.Email" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Name">Name</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Name" class="form-control" required />
                        <span asp-validation-for="Input.Name" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <button type="submit" class="btn">Book Now</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
