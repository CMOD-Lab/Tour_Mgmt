@page
@model Tour_Management.Pages.User.SignUpModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="page-header">
    <h1>User Registration</h1>
</div>

<div class="container">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="@(Model.IsSuccess ? "alert-success" : "alert-danger")">
            @Model.StatusMessage
        </div>
    }

    <div class="row">
        <div class="form-horizontal col-md-7">
            <form method="post">
                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Email">Email</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Email" class="form-control" type="email" required />
                        <span asp-validation-for="Input.Email" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.FirstName">First Name</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.FirstName" class="form-control" required />
                        <span asp-validation-for="Input.FirstName" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.LastName">Last Name</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Gender">Gender</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Gender" class="form-control" />
                        <span asp-validation-for="Input.Gender" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Password">Password</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Password" class="form-control" type="password" required />
                        <span asp-validation-for="Input.Password" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Dob">Date of Birth</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Dob" class="form-control" type="date" />
                        <span asp-validation-for="Input.Dob" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.Street">Street</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.Street" class="form-control" />
                        <span asp-validation-for="Input.Street" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.City">City</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.City" class="form-control" />
                        <span asp-validation-for="Input.City" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-sm-3" asp-for="Input.State">State</label>
                    <div class="col-sm-6">
                        <input asp-for="Input.State" class="form-control" />
                        <span asp-validation-for="Input.State" class="alert-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <button type="submit" class="btn">Register</button>
                    </div>
                    <div class="control-label col-sm-3">
                        <a href="/User/Login" class="btn">Already have an account? Login</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
