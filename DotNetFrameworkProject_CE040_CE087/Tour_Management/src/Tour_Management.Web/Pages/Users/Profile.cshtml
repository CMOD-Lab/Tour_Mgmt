@page
@model Tour_Management.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@if (Model.UserProfile == null)
{
    <div class="alert alert-warning">Please <a asp-page="./Login">login</a> to view your profile.</div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3>👤 My Profile</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    <table class="table">
                        <tr>
                            <th>Full Name</th>
                            <td>@Model.UserProfile.FullName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.UserProfile.Email</td>
                        </tr>
                        <tr>
                            <th>Gender</th>
                            <td>@(Model.UserProfile.Gender ?? "Not specified")</td>
                        </tr>
                        <tr>
                            <th>Date of Birth</th>
                            <td>@(Model.UserProfile.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not specified")</td>
                        </tr>
                        <tr>
                            <th>Address</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.UserProfile.Street))
                                {
                                    @Model.UserProfile.Street<text>, </text>
                                }
                                @Model.UserProfile.City @Model.UserProfile.State
                            </td>
                        </tr>
                    </table>
                    <div class="mt-3">
                        <a asp-page="/Bookings/MyBookings" class="btn btn-info me-2">My Bookings</a>
                        <a asp-page="./Logout" class="btn btn-danger">Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
