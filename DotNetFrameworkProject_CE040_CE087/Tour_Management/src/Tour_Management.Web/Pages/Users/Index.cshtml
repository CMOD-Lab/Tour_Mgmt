@page
@model Tour_Management.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>
<hr />

@if (!Model.Users.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Gender</th>
                <th>City</th>
                <th>State</th>
                <th>Joined</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@(user.Gender ?? "-")</td>
                    <td>@(user.City ?? "-")</td>
                    <td>@(user.State ?? "-")</td>
                    <td>@user.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-page="./Delete" asp-route-id="@user.UserId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
