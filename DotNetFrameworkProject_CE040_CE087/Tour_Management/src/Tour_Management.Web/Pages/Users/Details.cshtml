@page "{id:int}"
@model Tour_Management.Web.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "User Details";
}

<h1>👤 User Details</h1>
<hr />

@if (Model.User == null)
{
    <div class="alert alert-danger">User not found.</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.User.FullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>

        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">@(Model.User.Gender ?? "Not specified")</dd>

        <dt class="col-sm-3">Date of Birth</dt>
        <dd class="col-sm-9">@(Model.User.Dob ?? "Not specified")</dd>

        <dt class="col-sm-3">City</dt>
        <dd class="col-sm-9">@(Model.User.City ?? "Not specified")</dd>

        <dt class="col-sm-3">State</dt>
        <dd class="col-sm-9">@(Model.User.State ?? "Not specified")</dd>

        <dt class="col-sm-3">Registered</dt>
        <dd class="col-sm-9">@Model.User.CreatedDate.ToString("dd MMM yyyy")</dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-secondary">Back to Users</a>
        @if (HttpContext.Session.GetString("IsAdmin") == "true")
        {
            <a asp-page="Edit" asp-route-id="@Model.User.UserId" class="btn btn-warning">Edit</a>
        }
    </div>
}
