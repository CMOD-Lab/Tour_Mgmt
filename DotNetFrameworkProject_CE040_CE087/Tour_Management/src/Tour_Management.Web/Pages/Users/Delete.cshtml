@page "{id:int}"
@model Tour_Management.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<h1>🗑️ Delete User</h1>
<hr />

@if (Model.User == null)
{
    <div class="alert alert-danger">User not found.</div>
}
else
{
    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this user?</strong>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.User.FullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>
    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.User.UserId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
