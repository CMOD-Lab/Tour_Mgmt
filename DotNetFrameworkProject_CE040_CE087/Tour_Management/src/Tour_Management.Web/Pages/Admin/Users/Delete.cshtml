@page "{id:int}"
@model Tour_Management.Web.Pages.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<h1 class="mb-4 text-danger">Delete User</h1>

@if (Model.UserToDelete == null)
{
    <div class="alert alert-warning">User not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <div class="alert alert-warning">
        <strong>Warning!</strong> Are you sure you want to delete this user?
    </div>
    <div class="card shadow">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.UserToDelete.FullName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.UserToDelete.Email</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form method="post">
                <input type="hidden" name="id" value="@Model.UserToDelete.UserId" />
                <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
