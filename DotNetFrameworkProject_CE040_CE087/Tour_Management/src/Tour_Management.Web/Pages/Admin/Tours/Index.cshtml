@page
@model Tour_Management.Web.Pages.Admin.Tours.IndexModel
@{
    ViewData["Title"] = "Manage Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Tours</h1>
    <a asp-page="./Create" class="btn btn-primary">+ Add New Tour</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Days</th>
                <th>Price</th>
                <th>Locations</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tour in Model.Tours)
            {
                <tr>
                    <td>@tour.TourId</td>
                    <td>@tour.TourName</td>
                    <td>@tour.Place</td>
                    <td>@tour.Days</td>
                    <td>₹@tour.Price.ToString("N2")</td>
                    <td>@tour.Locations</td>
                    <td>
                        @if (tour.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        <a asp-page="./Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
