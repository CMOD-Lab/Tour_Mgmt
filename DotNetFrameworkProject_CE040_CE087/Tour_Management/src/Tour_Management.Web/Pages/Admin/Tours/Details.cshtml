@page "{id:int}"
@model Tour_Management.Web.Pages.Admin.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1 class="mb-4">Tour Details</h1>

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
}
else
{
    <div class="card shadow">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour ID</dt>
                <dd class="col-sm-9">@Model.Tour.TourId</dd>
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>
                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N2")</dd>
                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>
                <dt class="col-sm-3">Tour Info</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Tour.CreatedDate.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Tour.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
            </dl>
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/Tour_pics/@Model.Tour.Pic" class="img-thumbnail" style="max-height: 200px;" onerror="this.style.display='none'" />
            }
        </div>
        <div class="card-footer">
            <a asp-page="./Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning me-2">Edit</a>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
}
