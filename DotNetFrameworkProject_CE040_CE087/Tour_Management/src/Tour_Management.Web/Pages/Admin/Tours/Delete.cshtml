@page "{id:int}"
@model Tour_Management.Web.Pages.Admin.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1 class="mb-4 text-danger">Delete Tour</h1>

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <div class="alert alert-warning">
        <strong>Warning!</strong> Are you sure you want to delete this tour?
    </div>
    <div class="card shadow">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>
                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N2")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form method="post">
                <input type="hidden" name="id" value="@Model.Tour.TourId" />
                <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
