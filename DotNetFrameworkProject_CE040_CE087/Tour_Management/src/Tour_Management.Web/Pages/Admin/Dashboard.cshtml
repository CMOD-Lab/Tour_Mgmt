@page
@model Tour_Management.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<hr />

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalTours</h2>
                <p class="mb-0">Total Tours</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Tours/Index" class="text-white">View Tours →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalBookings</h2>
                <p class="mb-0">Total Bookings</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Bookings/Index" class="text-white">View Bookings →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalUsers</h2>
                <p class="mb-0">Registered Users</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Users/Index" class="text-white">View Users →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body text-center">
                <h2>+</h2>
                <p class="mb-0">Add New Tour</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Tours/Create" class="text-dark">Add Tour →</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Tours/Create" class="btn btn-primary">Add New Tour</a>
                    <a asp-page="/Bookings/Index" class="btn btn-success">View All Bookings</a>
                    <a asp-page="/Users/Index" class="btn btn-info">Manage Users</a>
                </div>
            </div>
        </div>
    </div>
</div>
