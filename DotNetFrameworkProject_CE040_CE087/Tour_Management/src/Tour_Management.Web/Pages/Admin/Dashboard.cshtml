@page
@model Tour_Management.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (HttpContext.Session.GetString("IsAdmin") != "true")
{
    <div class="alert alert-danger">Access denied.</div>
    <a asp-page="./Login" class="btn btn-primary">Admin Login</a>
}
else
{
    <h1>🛠️ Admin Dashboard</h1>
    <hr />

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white text-center shadow">
                <div class="card-body">
                    <h2>@Model.TotalTours</h2>
                    <p class="mb-0">Total Tours</p>
                </div>
                <div class="card-footer">
                    <a asp-page="/Tours/Index" class="text-white">View Tours →</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white text-center shadow">
                <div class="card-body">
                    <h2>@Model.TotalBookings</h2>
                    <p class="mb-0">Total Bookings</p>
                </div>
                <div class="card-footer">
                    <a asp-page="./Bookings" class="text-white">View Bookings →</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white text-center shadow">
                <div class="card-body">
                    <h2>@Model.TotalUsers</h2>
                    <p class="mb-0">Registered Users</p>
                </div>
                <div class="card-footer">
                    <a asp-page="./Users" class="text-white">View Users →</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark text-center shadow">
                <div class="card-body">
                    <h2>+</h2>
                    <p class="mb-0">Add New Tour</p>
                </div>
                <div class="card-footer">
                    <a asp-page="/Tours/Create" class="text-dark">Add Tour →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Quick Actions</div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Tours/Create" class="btn btn-outline-primary">➕ Add New Tour</a>
                        <a asp-page="./Users" class="btn btn-outline-info">👥 Manage Users</a>
                        <a asp-page="./Bookings" class="btn btn-outline-success">📋 View All Bookings</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
