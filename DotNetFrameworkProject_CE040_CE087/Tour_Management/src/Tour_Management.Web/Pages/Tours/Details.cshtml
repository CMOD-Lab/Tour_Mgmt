@page
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <h1>@Model.Tour.TourName</h1>
            <hr />
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded mb-3" alt="@Model.Tour.TourName" style="max-height: 400px; width: 100%; object-fit: cover;" />
            }
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tour Information</h5>
                    <p class="card-text">@Model.Tour.TourInfo</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Tour Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <td><strong>📍 Place</strong></td>
                            <td>@Model.Tour.Place</td>
                        </tr>
                        <tr>
                            <td><strong>📅 Duration</strong></td>
                            <td>@Model.Tour.Days days</td>
                        </tr>
                        <tr>
                            <td><strong>📌 Locations</strong></td>
                            <td>@Model.Tour.Locations</td>
                        </tr>
                        <tr>
                            <td><strong>💰 Price</strong></td>
                            <td class="text-success fw-bold">₹@Model.Tour.Price.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
                <div class="card-footer">
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" asp-route-tourName="@Model.Tour.TourName" asp-route-place="@Model.Tour.Place" class="btn btn-success w-100 mb-2">Book This Tour</a>
                    <a asp-page="./Index" class="btn btn-secondary w-100">Back to Tours</a>
                    @if (HttpContext.Session.GetString("IsAdmin") == "true")
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning w-100 mt-2">Edit Tour</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
