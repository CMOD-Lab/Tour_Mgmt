@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/placeholder.jpg'" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 300px;">
                    <span class="text-white" style="font-size: 5rem;">🌍</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1>@Model.Tour.TourName</h1>
            <table class="table table-bordered mt-3">
                <tr>
                    <th>📍 Place</th>
                    <td>@Model.Tour.Place</td>
                </tr>
                <tr>
                    <th>📅 Duration</th>
                    <td>@Model.Tour.Days days</td>
                </tr>
                <tr>
                    <th>💰 Price</th>
                    <td>₹@Model.Tour.Price.ToString("N2")</td>
                </tr>
                <tr>
                    <th>🗺️ Locations</th>
                    <td>@Model.Tour.Locations</td>
                </tr>
            </table>
            <h5>About This Tour</h5>
            <p>@Model.Tour.TourInfo</p>
            <div class="mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" asp-route-tourName="@Model.Tour.TourName" asp-route-place="@Model.Tour.Place" class="btn btn-success btn-lg me-2">Book Now</a>
                <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
            </div>
        </div>
    </div>
}
