@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-danger">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/tours/default.jpg'" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 300px;">
                    <span class="text-white" style="font-size: 5rem;">🌍</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1>@Model.Tour.TourName</h1>
            <hr />
            <dl class="row">
                <dt class="col-sm-4">📍 Place</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>

                <dt class="col-sm-4">⏱️ Duration</dt>
                <dd class="col-sm-8">@Model.Tour.Days days</dd>

                <dt class="col-sm-4">💰 Price</dt>
                <dd class="col-sm-8">₹@Model.Tour.Price.ToString("N0")</dd>

                <dt class="col-sm-4">🗺️ Locations</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>

                <dt class="col-sm-4">ℹ️ Tour Info</dt>
                <dd class="col-sm-8">@Model.Tour.TourInfo</dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" asp-route-tourName="@Model.Tour.TourName" asp-route-place="@Model.Tour.Place" class="btn btn-success btn-lg">
                    📅 Book This Tour
                </a>
                <a asp-page="Index" class="btn btn-secondary">Back to Tours</a>
                @if (HttpContext.Session.GetString("IsAdmin") == "true")
                {
                    <a asp-page="Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">Edit</a>
                }
            </div>
        </div>
    </div>
}
