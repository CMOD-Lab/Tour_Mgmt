@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>
<hr />

@if (Model.Input == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Input.TourId" />
                <input type="hidden" asp-for="Input.ExistingPic" />

                <div class="mb-3">
                    <label asp-for="Input.TourName" class="form-label"></label>
                    <input asp-for="Input.TourName" class="form-control" />
                    <span asp-validation-for="Input.TourName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Place" class="form-label"></label>
                    <input asp-for="Input.Place" class="form-control" />
                    <span asp-validation-for="Input.Place" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Days" class="form-label"></label>
                        <input asp-for="Input.Days" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Input.Days" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Price" class="form-label"></label>
                        <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Input.Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Locations" class="form-label"></label>
                    <input asp-for="Input.Locations" class="form-control" />
                    <span asp-validation-for="Input.Locations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.TourInfo" class="form-label"></label>
                    <textarea asp-for="Input.TourInfo" class="form-control" rows="4" maxlength="250"></textarea>
                    <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Input.ExistingPic))
                {
                    <div class="mb-3">
                        <label class="form-label">Current Image</label>
                        <div>
                            <img src="/Tour_pics/@Model.Input.ExistingPic" style="max-height: 150px;" class="img-thumbnail" alt="Current tour image" />
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Input.PicFile" class="form-label"></label>
                    <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                    <small class="text-muted">Leave empty to keep the current image.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-page="./Details" asp-route-id="@Model.Input.TourId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
