@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Tour.TourId" />

            <div class="mb-3">
                <label asp-for="Tour.TourName" class="form-label"></label>
                <input asp-for="Tour.TourName" class="form-control" />
                <span asp-validation-for="Tour.TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.Place" class="form-label"></label>
                <input asp-for="Tour.Place" class="form-control" />
                <span asp-validation-for="Tour.Place" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tour.Days" class="form-label"></label>
                    <input asp-for="Tour.Days" class="form-control" type="number" min="1" max="365" />
                    <span asp-validation-for="Tour.Days" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Tour.Price" class="form-label"></label>
                    <input asp-for="Tour.Price" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="Tour.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.Locations" class="form-label"></label>
                <input asp-for="Tour.Locations" class="form-control" />
                <span asp-validation-for="Tour.Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tour.TourInfo" class="form-label"></label>
                <textarea asp-for="Tour.TourInfo" class="form-control" rows="4" maxlength="250"></textarea>
                <span asp-validation-for="Tour.TourInfo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                @if (!string.IsNullOrEmpty(Model.Tour.ExistingPic))
                {
                    <p>Current image: <strong>@Model.Tour.ExistingPic</strong></p>
                    <img src="/tour-pics/@Model.Tour.ExistingPic" style="max-height:150px;" class="mb-2 rounded" onerror="this.style.display='none'" />
                }
                <label asp-for="Tour.PicFile" class="form-label">New Tour Image (leave empty to keep current)</label>
                <input asp-for="Tour.PicFile" class="form-control" type="file" accept="image/*" />
                <input type="hidden" asp-for="Tour.ExistingPic" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="./Details" asp-route-id="@Model.Tour.TourId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
