@page
@model Tour_Management.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🗺️ Available Tours</h1>
    @if (HttpContext.Session.GetString("IsAdmin") == "true")
    {
        <a asp-page="Create" class="btn btn-success">+ Add New Tour</a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <div class="alert alert-info">
        Showing results for: <strong>@Model.SearchTerm</strong>
        <a asp-page="Index" class="ms-2">Clear</a>
    </div>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name or place..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (!Model.Tours.Any())
{
    <div class="alert alert-warning">No tours found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var tour in Model.Tours)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" onerror="this.src='/images/tours/default.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white fs-1">🌍</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text">
                            <small>⏱️ @tour.Days days | 💰 ₹@tour.Price.ToString("N0")</small>
                        </p>
                        <p class="card-text">
                            <small class="text-muted">🗺️ @tour.Locations</small>
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-page="Details" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm flex-fill">Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" asp-route-tourName="@tour.TourName" asp-route-place="@tour.Place" class="btn btn-success btn-sm flex-fill">Book Now</a>
                        @if (HttpContext.Session.GetString("IsAdmin") == "true")
                        {
                            <a asp-page="Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
