@page
@model Tour_Management.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<h1 class="mb-4">Available Tours</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours..." />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="btn btn-outline-danger">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found. @(string.IsNullOrEmpty(Model.SearchTerm) ? "" : "Try a different search term.")</div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" onerror="this.src='/images/placeholder.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white fs-1">🌍</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>📍 Place:</strong> @tour.Place<br />
                            <strong>📅 Days:</strong> @tour.Days<br />
                            <strong>💰 Price:</strong> ₹@tour.Price.ToString("N2")<br />
                            <strong>🗺️ Locations:</strong> @tour.Locations
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" asp-route-tourName="@tour.TourName" asp-route-place="@tour.Place" class="btn btn-success btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
