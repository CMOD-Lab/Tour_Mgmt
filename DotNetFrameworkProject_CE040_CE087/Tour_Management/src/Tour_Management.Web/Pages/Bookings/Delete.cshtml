@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>🗑️ Delete Booking</h1>
<hr />

@if (Model.Booking == null)
{
    <div class="alert alert-danger">Booking not found.</div>
}
else
{
    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this booking?</strong>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Booking.TourName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Booking.Email</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.Booking.FirstName</dd>
    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Booking.BookingId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
