@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete Booking</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this booking?</h4>
</div>

@if (Model.Booking != null)
{
    <dl class="row">
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Booking.TourName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Booking.Email</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Booking.FirstName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Booking.BookingId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
else
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Bookings</a>
}
