@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Cancel Booking";
}

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
else
{
    <h1>Cancel Booking</h1>
    <hr />

    <div class="alert alert-warning">
        <h4>Are you sure you want to cancel this booking?</h4>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Booking.TourName</dd>

        <dt class="col-sm-3">Place</dt>
        <dd class="col-sm-9">@Model.Booking.Place</dd>

        <dt class="col-sm-3">Booking Date</dt>
        <dd class="col-sm-9">@Model.Booking.BookingDate.ToString("dd MMM yyyy")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Booking.BookingId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
            <a asp-page="./Details" asp-route-id="@Model.Booking.BookingId" class="btn btn-secondary">Keep Booking</a>
        </div>
    </form>
}
