@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<hr />

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Booking ID</dt>
        <dd class="col-sm-9">@Model.Booking.BookingId</dd>

        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Booking.TourName</dd>

        <dt class="col-sm-3">Place</dt>
        <dd class="col-sm-9">@Model.Booking.Place</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Booking.Email</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Booking.FirstName</dd>

        <dt class="col-sm-3">Booked On</dt>
        <dd class="col-sm-9">@Model.Booking.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.Booking.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </dd>
    </dl>

    <div class="d-flex gap-2">
        @if (HttpContext.Session.GetString("IsAdmin") == "true")
        {
            <a asp-page="./Edit" asp-route-id="@Model.Booking.BookingId" class="btn btn-primary">Edit</a>
            <a asp-page="./Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger">Delete</a>
        }
        <a asp-page="./Index" class="btn btn-secondary">Back to Bookings</a>
    </div>
}
