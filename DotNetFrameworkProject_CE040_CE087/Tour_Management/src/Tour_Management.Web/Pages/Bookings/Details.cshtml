@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
else
{
    <h1>Booking Details</h1>
    <hr />
    <div class="card" style="max-width: 500px;">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">✅ Booking Confirmed</h5>
        </div>
        <div class="card-body">
            <table class="table table-borderless">
                <tr>
                    <td><strong>Booking ID</strong></td>
                    <td>#@Model.Booking.BookingId</td>
                </tr>
                <tr>
                    <td><strong>Tour Name</strong></td>
                    <td>@Model.Booking.TourName</td>
                </tr>
                <tr>
                    <td><strong>Place</strong></td>
                    <td>@Model.Booking.Place</td>
                </tr>
                <tr>
                    <td><strong>Booked By</strong></td>
                    <td>@Model.Booking.FirstName</td>
                </tr>
                <tr>
                    <td><strong>Email</strong></td>
                    <td>@Model.Booking.Email</td>
                </tr>
                <tr>
                    <td><strong>Booking Date</strong></td>
                    <td>@Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            </table>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
            <a asp-page="./Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger">Cancel Booking</a>
        </div>
    </div>
}
