@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

@if (Model.Booking == null)
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3>Booking Confirmation</h3>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr>
                            <th>Booking ID</th>
                            <td>#@Model.Booking.BookingId</td>
                        </tr>
                        <tr>
                            <th>Tour Name</th>
                            <td>@Model.Booking.TourName</td>
                        </tr>
                        <tr>
                            <th>Place</th>
                            <td>@Model.Booking.Place</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.Booking.FirstName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.Booking.Email</td>
                        </tr>
                        <tr>
                            <th>Booking Date</th>
                            <td>@Model.Booking.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.Booking.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                            </td>
                        </tr>
                    </table>
                    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
                </div>
            </div>
        </div>
    </div>
}
