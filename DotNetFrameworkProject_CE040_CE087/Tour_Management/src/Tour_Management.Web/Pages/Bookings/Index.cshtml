@page
@model Tour_Management.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "My Bookings";
}

<h1>@(HttpContext.Session.GetString("IsAdmin") == "true" ? "All Bookings" : "My Bookings")</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Booked On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.Email</td>
                        <td>@booking.FirstName</td>
                        <td>@booking.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@booking.BookingId" class="btn btn-info btn-sm">Details</a>
                            @if (HttpContext.Session.GetString("IsAdmin") == "true")
                            {
                                <a asp-page="./Edit" asp-route-id="@booking.BookingId" class="btn btn-primary btn-sm">Edit</a>
                                <a asp-page="./Delete" asp-route-id="@booking.BookingId" class="btn btn-danger btn-sm">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-page="/Tours/Index" class="btn btn-secondary mt-3">Browse Tours</a>
