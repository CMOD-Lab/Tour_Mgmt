@page
@model Tour_Management.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h1>📋 My Bookings</h1>
<hr />

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to book one!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Booked On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-info">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
