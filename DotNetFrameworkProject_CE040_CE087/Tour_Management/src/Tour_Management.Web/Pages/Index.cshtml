@page
@model Tour_Management.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <div class="jumbotron bg-dark text-white p-5 rounded mb-4">
        <h1 class="display-4">Welcome to Tour Management</h1>
        <p class="lead">Discover amazing tours and book your next adventure!</p>
        <hr class="my-4" />
        <a class="btn btn-warning btn-lg" asp-page="/Tours/Index">Browse Tours</a>
        <a class="btn btn-outline-light btn-lg ms-2" asp-page="/Users/Register">Sign Up</a>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">🗺️ Explore Tours</h5>
                    <p class="card-text">Browse our wide selection of tours to amazing destinations around the world.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">📋 My Bookings</h5>
                    <p class="card-text">View and manage your tour bookings in one convenient place.</p>
                    <a asp-page="/Bookings/Index" class="btn btn-primary">My Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">👤 My Account</h5>
                    <p class="card-text">Manage your profile and account settings.</p>
                    <a asp-page="/Users/Profile" class="btn btn-primary">My Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
