@page
@model Tour_Management.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    var userEmail = ViewContext.HttpContext.Session.GetString("UserEmail");
}

<div class="jumbotron text-center py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px;">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your dream vacation today!</p>
    <hr class="my-4" />
    <a class="btn btn-light btn-lg me-2" asp-page="/Tours/Index">Browse Tours</a>
    @if (userEmail == null)
    {
        <a class="btn btn-outline-light btn-lg" asp-page="/Users/Register">Sign Up Now</a>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h2>🌍</h2>
                <h5 class="card-title">Explore Destinations</h5>
                <p class="card-text">Browse our wide selection of tours to amazing destinations around the world.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h2>📋</h2>
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Book your tour in just a few clicks. Simple, fast, and secure.</p>
                <a asp-page="/Users/Login" class="btn btn-success">Book Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h2>👤</h2>
                <h5 class="card-title">Manage Your Trips</h5>
                <p class="card-text">View and manage all your bookings from your personal profile.</p>
                <a asp-page="/Users/Register" class="btn btn-info">Get Started</a>
            </div>
        </div>
    </div>
</div>
