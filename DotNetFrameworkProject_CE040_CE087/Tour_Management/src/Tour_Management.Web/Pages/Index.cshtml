@page
@model Tour_Management.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome to Tour Management";
}

<div class="text-center">
    <div class="jumbotron py-5 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px;">
        <h1 class="display-4">🌍 Tour Management System</h1>
        <p class="lead">Discover amazing tours and book your dream vacation today!</p>
        <hr class="my-4" style="border-color: rgba(255,255,255,0.3);" />
        <a class="btn btn-light btn-lg me-2" asp-page="/Tours/Index">Browse Tours</a>
        @if (HttpContext.Session.GetString("UserEmail") == null)
        {
            <a class="btn btn-outline-light btn-lg" asp-page="/Users/Register">Sign Up Free</a>
        }
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2>🗺️</h2>
                    <h5 class="card-title">Explore Destinations</h5>
                    <p class="card-text">Browse our curated collection of tours to amazing destinations around the world.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2>📅</h2>
                    <h5 class="card-title">Easy Booking</h5>
                    <p class="card-text">Book your favorite tour in just a few clicks. Simple, fast, and secure.</p>
                    @if (HttpContext.Session.GetString("UserEmail") != null)
                    {
                        <a asp-page="/Bookings/MyBookings" class="btn btn-success">My Bookings</a>
                    }
                    else
                    {
                        <a asp-page="/Users/Login" class="btn btn-success">Login to Book</a>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2>👤</h2>
                    <h5 class="card-title">Your Account</h5>
                    <p class="card-text">Manage your profile, view your bookings, and track your travel history.</p>
                    @if (HttpContext.Session.GetString("UserEmail") != null)
                    {
                        <a asp-page="/Users/Profile" class="btn btn-info">My Profile</a>
                    }
                    else
                    {
                        <a asp-page="/Users/Register" class="btn btn-info">Create Account</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
