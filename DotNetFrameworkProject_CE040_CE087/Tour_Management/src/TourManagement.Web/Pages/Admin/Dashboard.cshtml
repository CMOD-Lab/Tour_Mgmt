@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card bg-primary text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalTours</h2>
                    <p class="mb-0">Total Tours</p>
                </div>
                <i class="bi bi-map" style="font-size: 3rem; opacity: 0.5;"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Tours/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>Manage Tours
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-success text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalBookings</h2>
                    <p class="mb-0">Total Bookings</p>
                </div>
                <i class="bi bi-calendar-check" style="font-size: 3rem; opacity: 0.5;"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Bookings/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>View All Bookings
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-info text-white shadow">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">@Model.TotalUsers</h2>
                    <p class="mb-0">Registered Users</p>
                </div>
                <i class="bi bi-people" style="font-size: 3rem; opacity: 0.5;"></i>
            </div>
            <div class="card-footer">
                <a asp-page="/Users/Index" class="text-white text-decoration-none">
                    <i class="bi bi-arrow-right me-1"></i>Manage Users
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <h3>Quick Actions</h3>
    </div>
    <div class="col-md-3 mb-2">
        <a asp-page="/Tours/Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle me-2"></i>Add New Tour
        </a>
    </div>
    <div class="col-md-3 mb-2">
        <a asp-page="/Tours/Index" class="btn btn-outline-primary w-100">
            <i class="bi bi-map me-2"></i>View All Tours
        </a>
    </div>
    <div class="col-md-3 mb-2">
        <a asp-page="/Bookings/Index" class="btn btn-outline-success w-100">
            <i class="bi bi-calendar-check me-2"></i>View All Bookings
        </a>
    </div>
    <div class="col-md-3 mb-2">
        <a asp-page="/Users/Index" class="btn btn-outline-info w-100">
            <i class="bi bi-people me-2"></i>Manage Users
        </a>
    </div>
</div>

<!-- Recent Bookings -->
<div class="row">
    <div class="col-12">
        <h3>Recent Bookings</h3>
        @if (Model.RecentBookings.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Tour</th>
                            <th>Customer</th>
                            <th>Email</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td>@booking.TourName</td>
                                <td>@booking.FirstName</td>
                                <td>@booking.Email</td>
                                <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No bookings yet.</p>
        }
    </div>
</div>
