@page
@model TourManagement.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<hr />

<partial name="_Notifications" />

@if (!Model.IsAdmin)
{
    <div class="alert alert-danger">
        <strong>Access Denied.</strong> Please <a asp-page="Login">login as admin</a>.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        <div class="col">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Tours</h5>
                    <p class="card-text display-4">@Model.TotalTours</p>
                    <a asp-page="/Tours/Index" class="btn btn-light">Manage Tours</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Users</h5>
                    <p class="card-text display-4">@Model.TotalUsers</p>
                    <a asp-page="/Users/Index" class="btn btn-light">Manage Users</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Bookings</h5>
                    <p class="card-text display-4">@Model.TotalBookings</p>
                    <a asp-page="/Bookings/Index" class="btn btn-light">Manage Bookings</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h4>Quick Actions</h4>
            <div class="list-group">
                <a asp-page="/Tours/Create" class="list-group-item list-group-item-action">➕ Add New Tour</a>
                <a asp-page="/Tours/Index" class="list-group-item list-group-item-action">🗺️ View All Tours</a>
                <a asp-page="/Bookings/Index" class="list-group-item list-group-item-action">📋 View All Bookings</a>
                <a asp-page="/Users/Index" class="list-group-item list-group-item-action">👥 View All Users</a>
            </div>
        </div>
    </div>
}
