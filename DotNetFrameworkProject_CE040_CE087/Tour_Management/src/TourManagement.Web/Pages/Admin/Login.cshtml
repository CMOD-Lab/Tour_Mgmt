@page
@model TourManagement.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Admin Login</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="Admin email" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="Admin password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">
                                <i class="bi bi-shield-check me-2"></i>Admin Login
                            </button>
                        </div>
                    </form>
                    <hr />
                    <div class="text-center">
                        <a asp-page="/Users/Login" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-person me-2"></i>User Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
