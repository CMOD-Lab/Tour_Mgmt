@page
@model TourManagement.Web.Pages.Users.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Create Account</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.LastName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Email" class="form-control" placeholder="Enter email address" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Password" class="form-control" placeholder="Enter password" />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Gender" class="form-label fw-semibold"></label>
                                <select asp-for="Input.Gender" class="form-select">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DateOfBirth" class="form-label fw-semibold"></label>
                                <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Street" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Street" class="form-control" placeholder="Enter street address" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.City" class="form-label fw-semibold"></label>
                                <input asp-for="Input.City" class="form-control" placeholder="Enter city" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.State" class="form-label fw-semibold"></label>
                                <input asp-for="Input.State" class="form-control" placeholder="Enter state" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-person-check me-2"></i>Register
                            </button>
                            <a asp-page="Login" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Already have an account? Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
