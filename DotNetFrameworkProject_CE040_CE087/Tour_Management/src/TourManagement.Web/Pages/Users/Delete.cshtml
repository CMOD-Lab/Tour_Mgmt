@page "{id:int}"
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-trash me-2"></i>Delete User</h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.UserToDelete == null)
                    {
                        <div class="alert alert-warning">User not found.</div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this user?
                        </div>
                        <dl class="row">
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.UserToDelete.FirstName @Model.UserToDelete.LastName</dd>
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.UserToDelete.Email</dd>
                            <dt class="col-sm-4">Role</dt>
                            <dd class="col-sm-8">@Model.UserToDelete.Role</dd>
                        </dl>
                        <form method="post">
                            <input type="hidden" name="id" value="@Model.UserToDelete.Id" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-trash me-2"></i>Yes, Delete
                                </button>
                                <a asp-page="Index" class="btn btn-outline-secondary px-4">
                                    <i class="bi bi-arrow-left me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
