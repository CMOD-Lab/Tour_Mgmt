@page "{id:int}"
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    @if (Model.UserProfile == null)
    {
        <div class="alert alert-warning">User not found. <a asp-page="Login" class="alert-link">Login</a></div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h4 class="fw-bold">@Model.UserProfile.FullName</h4>
                        <p class="text-muted">@Model.UserProfile.Email</p>
                        <span class="badge @(Model.UserProfile.Role == "Admin" ? "bg-danger" : "bg-primary")">
                            @Model.UserProfile.Role
                        </span>
                    </div>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-page="Edit" asp-route-id="@Model.UserProfile.Id" class="btn btn-outline-warning">
                                <i class="bi bi-pencil me-2"></i>Edit Profile
                            </a>
                            <a asp-page="/Bookings/MyBookings" asp-route-email="@Model.UserProfile.Email"
                               class="btn btn-outline-primary">
                                <i class="bi bi-calendar-check me-2"></i>My Bookings
                            </a>
                            <a asp-page="/Users/Logout" class="btn btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2"></i>Profile Details</h5>
                    </div>
                    <div class="card-body p-4">
                        <dl class="row">
                            <dt class="col-sm-4">Full Name</dt>
                            <dd class="col-sm-8">@Model.UserProfile.FullName</dd>
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.UserProfile.Email</dd>
                            <dt class="col-sm-4">Gender</dt>
                            <dd class="col-sm-8">@(Model.UserProfile.Gender ?? "Not specified")</dd>
                            <dt class="col-sm-4">Date of Birth</dt>
                            <dd class="col-sm-8">@(Model.UserProfile.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not specified")</dd>
                            <dt class="col-sm-4">Street</dt>
                            <dd class="col-sm-8">@(Model.UserProfile.Street ?? "Not specified")</dd>
                            <dt class="col-sm-4">City</dt>
                            <dd class="col-sm-8">@(Model.UserProfile.City ?? "Not specified")</dd>
                            <dt class="col-sm-4">State</dt>
                            <dd class="col-sm-8">@(Model.UserProfile.State ?? "Not specified")</dd>
                            <dt class="col-sm-4">Member Since</dt>
                            <dd class="col-sm-8">@Model.UserProfile.CreatedDate.ToString("dd MMM yyyy")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
