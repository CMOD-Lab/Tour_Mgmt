@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>
<hr />

<partial name="_Notifications" />

@if (Model.User != null)
{
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.User.Email</dd>

                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.User.FirstName</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.User.LastName</dd>

                <dt class="col-sm-4">Gender</dt>
                <dd class="col-sm-8">@(Model.User.Gender ?? "N/A")</dd>

                <dt class="col-sm-4">Date of Birth</dt>
                <dd class="col-sm-8">@(Model.User.Dob ?? "N/A")</dd>

                <dt class="col-sm-4">Street</dt>
                <dd class="col-sm-8">@(Model.User.Street ?? "N/A")</dd>

                <dt class="col-sm-4">City</dt>
                <dd class="col-sm-8">@(Model.User.City ?? "N/A")</dd>

                <dt class="col-sm-4">State</dt>
                <dd class="col-sm-8">@(Model.User.State ?? "N/A")</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="Edit" asp-route-id="@Model.User.Id" class="btn btn-warning">Edit Profile</a>
                <a asp-page="/Bookings/MyBookings" class="btn btn-info ms-2">My Bookings</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Please <a asp-page="Login">login</a> to view your profile.</div>
}
