@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>Tour not found.
        <a asp-page="Index" class="alert-link">Back to Tours</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Tours</a></li>
            <li class="breadcrumb-item active">@Model.Tour.TourName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName"
                     onerror="this.src='/images/default-tour.jpg'" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 300px;">
                    <i class="bi bi-image text-white" style="font-size: 5rem;"></i>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1 class="mb-3">@Model.Tour.TourName</h1>
            <div class="mb-3">
                <span class="badge bg-primary fs-6 me-2">
                    <i class="bi bi-geo-alt me-1"></i>@Model.Tour.Place
                </span>
                <span class="badge bg-info fs-6 me-2">
                    <i class="bi bi-calendar me-1"></i>@Model.Tour.Days Days
                </span>
                <span class="badge bg-success fs-6">
                    <i class="bi bi-currency-dollar me-1"></i>@Model.Tour.Price.ToString("N2")
                </span>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-pin-map me-2"></i>Locations</h5>
                    <p class="card-text">@Model.Tour.Locations</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-info-circle me-2"></i>Tour Information</h5>
                    <p class="card-text">@Model.Tour.TourInfo</p>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success btn-lg">
                    <i class="bi bi-calendar-check me-2"></i>Book This Tour
                </a>
                <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Back to Tours
                </a>
                @if (ViewContext.HttpContext.Session.GetString("IsAdmin") == "true")
                {
                    <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning btn-lg">
                        <i class="bi bi-pencil me-2"></i>Edit
                    </a>
                }
            </div>
        </div>
    </div>
}
