@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>
<hr />

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/Tour_pics/@Model.Tour.Pic" class="img-fluid mb-3 rounded" alt="@Model.Tour.TourName" style="max-height:400px;object-fit:cover;" onerror="this.style.display='none'" />
            }
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>

                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Tour Information</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Tour.CreatedDate.ToString("yyyy-MM-dd")</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" asp-route-tourName="@Model.Tour.TourName" asp-route-place="@Model.Tour.Place" class="btn btn-success">Book This Tour</a>
                <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning ms-2">Edit</a>
                <a asp-page="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </div>
    </div>
}
