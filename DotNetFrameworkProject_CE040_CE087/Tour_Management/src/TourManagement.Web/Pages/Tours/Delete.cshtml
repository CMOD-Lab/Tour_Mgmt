@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>
<hr />

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to delete this tour?
</div>

@if (Model.Tour != null)
{
    <dl class="row">
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Tour.TourName</dd>

        <dt class="col-sm-3">Place</dt>
        <dd class="col-sm-9">@Model.Tour.Place</dd>

        <dt class="col-sm-3">Days</dt>
        <dd class="col-sm-9">@Model.Tour.Days</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Tour.Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
}
else
{
    <div class="alert alert-info">Tour not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
