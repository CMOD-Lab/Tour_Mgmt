@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-trash me-2"></i>Delete Tour</h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.Tour == null)
                    {
                        <div class="alert alert-warning">Tour not found.</div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this tour? This action cannot be undone.
                        </div>

                        <dl class="row">
                            <dt class="col-sm-4">Tour Name</dt>
                            <dd class="col-sm-8">@Model.Tour.TourName</dd>
                            <dt class="col-sm-4">Place</dt>
                            <dd class="col-sm-8">@Model.Tour.Place</dd>
                            <dt class="col-sm-4">Days</dt>
                            <dd class="col-sm-8">@Model.Tour.Days</dd>
                            <dt class="col-sm-4">Price</dt>
                            <dd class="col-sm-8">₹@Model.Tour.Price.ToString("N0")</dd>
                            <dt class="col-sm-4">Locations</dt>
                            <dd class="col-sm-8">@Model.Tour.Locations</dd>
                        </dl>

                        <form method="post">
                            <input type="hidden" name="id" value="@Model.Tour.Id" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-trash me-2"></i>Yes, Delete
                                </button>
                                <a asp-page="Details" asp-route-id="@Model.Tour.Id" class="btn btn-outline-secondary px-4">
                                    <i class="bi bi-arrow-left me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
