@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Tour</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Input.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.TourName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.TourName" class="form-control" />
                                <span asp-validation-for="Input.TourName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Place" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Place" class="form-control" />
                                <span asp-validation-for="Input.Place" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Days" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Days" class="form-control" type="number" min="1" max="365" />
                                <span asp-validation-for="Input.Days" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Price" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">&#8377;</span>
                                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Input.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check mt-4 pt-2">
                                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="Input.IsActive" class="form-check-label fw-semibold">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Locations" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Locations" class="form-control" />
                                <span asp-validation-for="Input.Locations" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.TourInfo" class="form-label fw-semibold"></label>
                                <textarea asp-for="Input.TourInfo" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Input.TourInfo" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                @if (!string.IsNullOrEmpty(Model.Input.ExistingPic))
                                {
                                    <div class="mb-2">
                                        <small class="text-muted">Current picture: @Model.Input.ExistingPic</small>
                                    </div>
                                }
                                <label asp-for="Input.PicFile" class="form-label fw-semibold"></label>
                                <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                                <small class="text-muted">Leave empty to keep the current picture.</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
