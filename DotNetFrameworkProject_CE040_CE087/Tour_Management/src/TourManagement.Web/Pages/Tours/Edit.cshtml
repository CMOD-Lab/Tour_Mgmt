@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Tours</a></li>
        <li class="breadcrumb-item active">Edit Tour</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-pencil me-2"></i>Edit Tour</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Input.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Days" class="form-label"></label>
                            <input asp-for="Input.Days" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Input.Days" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Locations" class="form-label"></label>
                        <input asp-for="Input.Locations" class="form-control" />
                        <span asp-validation-for="Input.Locations" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.TourInfo" class="form-label"></label>
                        <textarea asp-for="Input.TourInfo" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Input.CurrentPic))
                    {
                        <div class="mb-3">
                            <label class="form-label">Current Picture</label>
                            <div>
                                <img src="~/images/tours/@Model.Input.CurrentPic" alt="Current tour picture"
                                     style="max-height: 150px;" class="img-thumbnail"
                                     onerror="this.style.display='none'" />
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Input.PicFile" class="form-label">
                            @(string.IsNullOrEmpty(Model.Input.CurrentPic) ? "Picture" : "Replace Picture")
                        </label>
                        <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="Input.PicFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
