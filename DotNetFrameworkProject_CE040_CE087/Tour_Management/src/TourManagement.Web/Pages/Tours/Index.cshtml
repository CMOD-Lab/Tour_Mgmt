@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-map me-2"></i>Tours</h1>
    @if (ViewContext.HttpContext.Session.GetString("IsAdmin") == "true")
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add New Tour
        </a>
    }
</div>

<!-- Search -->
<div class="row mb-4">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                       placeholder="Search tours by name or place..." />
                <button class="btn btn-outline-primary" type="submit">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">
                            <i class="bi bi-geo-alt me-1"></i>@tour.Place
                        </p>
                        <p class="card-text">
                            <span class="badge bg-info me-2"><i class="bi bi-calendar me-1"></i>@tour.Days Days</span>
                            <span class="badge bg-success"><i class="bi bi-currency-dollar me-1"></i>@tour.Price.ToString("N2")</span>
                        </p>
                        <p class="card-text small text-muted">
                            <i class="bi bi-pin-map me-1"></i>@tour.Locations
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-1 flex-wrap">
                        <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-info btn-sm text-white">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm">
                            <i class="bi bi-calendar-check me-1"></i>Book
                        </a>
                        @if (ViewContext.HttpContext.Session.GetString("IsAdmin") == "true")
                        {
                            <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span>No tours found matching "@Model.SearchTerm".</span>
        }
        else
        {
            <span>No tours available at the moment.</span>
        }
    </div>
}
