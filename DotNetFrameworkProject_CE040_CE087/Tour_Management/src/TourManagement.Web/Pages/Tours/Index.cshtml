@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "All Tours";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-map me-2 text-primary"></i>All Tours</h1>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add New Tour
        </a>
    </div>

    <!-- Search Bar -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control form-control-lg" placeholder="Search tours by name, place, or location..." />
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-search me-1"></i>Search
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </a>
            }
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Tours.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
            <h4 class="text-muted mt-3">No tours found</h4>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.SearchTerm) ? "No tours have been added yet." : $"No tours match '{Model.SearchTerm}'.")</p>
            <a asp-page="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Add First Tour
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(tour.Pic))
                        {
                            <img src="/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-tour.jpg'">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@tour.TourName</h5>
                            <p class="card-text text-muted mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@tour.Place
                            </p>
                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-pin-map me-1"></i>@tour.Locations
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info text-dark">
                                    <i class="bi bi-calendar3 me-1"></i>@tour.Days Days
                                </span>
                                <span class="fw-bold text-success fs-5">&#8377;@tour.Price.ToString("N0")</span>
                            </div>
                            <p class="card-text small text-muted">
                                @(tour.TourInfo.Length > 80 ? tour.TourInfo[..80] + "..." : tour.TourInfo)
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-page="Details" asp-route-id="@tour.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@tour.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@tour.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                                <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id"
                                   class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-cart-plus me-1"></i>Book
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 text-muted small">
            Showing @Model.Tours.Count() tour(s)
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <span>for "@Model.SearchTerm"</span>
            }
        </div>
    }
</div>
