@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
            <h1 class="mt-3 fw-bold">Oops! Something went wrong.</h1>
            <p class="text-muted">We're sorry for the inconvenience. Please try again later.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted small">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }
            <a asp-page="/Index" class="btn btn-primary mt-3">
                <i class="bi bi-house me-2"></i>Go Home
            </a>
        </div>
    </div>
</div>
