@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger"><i class="bi bi-exclamation-triangle"></i></h1>
    <h2>An Error Occurred</h2>
    <p class="lead">Sorry, something went wrong. Please try again later.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-3">
        <i class="bi bi-house me-2"></i>Go Home
    </a>
</div>
