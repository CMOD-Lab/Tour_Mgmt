@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="MyBookings">My Bookings</a></li>
        <li class="breadcrumb-item active">Booking Details</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-calendar-check me-2"></i>Booking Details</h1>

@if (Model.Booking == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>Booking not found.
        <a asp-page="MyBookings" class="alert-link">Back to My Bookings</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Booking #@Model.Booking.Id</h5>
            @if (Model.Booking.IsActive)
            {
                <span class="badge bg-success fs-6">Active</span>
            }
            else
            {
                <span class="badge bg-danger fs-6">Cancelled</span>
            }
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Booking.TourName</dd>
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Booking.Place</dd>
                <dt class="col-sm-3">Customer Name</dt>
                <dd class="col-sm-9">@Model.Booking.FirstName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Booking.Email</dd>
                <dt class="col-sm-3">Booking Date</dt>
                <dd class="col-sm-9">@Model.Booking.BookingDate.ToString("MMMM dd, yyyy HH:mm")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-page="MyBookings" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to My Bookings
            </a>
            @if (Model.Booking.IsActive)
            {
                <a asp-page="Delete" asp-route-id="@Model.Booking.Id" class="btn btn-danger ms-2">
                    <i class="bi bi-x-circle me-2"></i>Cancel Booking
                </a>
            }
        </div>
    </div>
}
