@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-4">
    @if (Model.Booking == null)
    {
        <div class="alert alert-warning">Booking not found. <a asp-page="Index" class="alert-link">Back to Bookings</a></div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Booking Details</h4>
                    </div>
                    <div class="card-body p-4">
                        <dl class="row">
                            <dt class="col-sm-4">Booking ID</dt>
                            <dd class="col-sm-8">#@Model.Booking.Id</dd>
                            <dt class="col-sm-4">Tour Name</dt>
                            <dd class="col-sm-8">@Model.Booking.TourName</dd>
                            <dt class="col-sm-4">Destination</dt>
                            <dd class="col-sm-8">@Model.Booking.Place</dd>
                            <dt class="col-sm-4">Customer Name</dt>
                            <dd class="col-sm-8">@Model.Booking.FirstName</dd>
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Booking.Email</dd>
                            <dt class="col-sm-4">Booking Date</dt>
                            <dd class="col-sm-8">@Model.Booking.BookingDate.ToString("dd MMM yyyy HH:mm")</dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.Booking.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.Booking.IsActive ? "Active" : "Cancelled")
                                </span>
                            </dd>
                        </dl>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 px-4">
                        <div class="d-flex gap-2">
                            <a asp-page="Edit" asp-route-id="@Model.Booking.Id" class="btn btn-outline-warning">
                                <i class="bi bi-pencil me-2"></i>Edit
                            </a>
                            <a asp-page="Delete" asp-route-id="@Model.Booking.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-2"></i>Cancel Booking
                            </a>
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
