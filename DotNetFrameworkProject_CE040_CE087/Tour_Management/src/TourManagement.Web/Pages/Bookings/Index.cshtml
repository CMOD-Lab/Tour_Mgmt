@page
@model TourManagement.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "All Bookings";
}

<h1>All Bookings</h1>
<hr />

<partial name="_Notifications" />

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search bookings..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="Index" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Customer Name</th>
                <th>Email</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.FirstName</td>
                    <td>@booking.Email</td>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
