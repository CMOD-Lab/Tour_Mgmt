@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a Tour";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Tours/Index">Tours</a></li>
        <li class="breadcrumb-item active">Book Tour</li>
    </ol>
</nav>

<h1 class="mb-4"><i class="bi bi-calendar-plus me-2"></i>Book a Tour</h1>

@if (Model.SelectedTour != null)
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Booking: <strong>@Model.SelectedTour.TourName</strong> - @Model.SelectedTour.Place
        (@Model.SelectedTour.Days days, $@Model.SelectedTour.Price.ToString("N2"))
    </div>
}

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" asp-for="Input.TourId" />

                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" placeholder="Tour name" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" placeholder="Destination" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Your first name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" placeholder="Your email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-calendar-check me-2"></i>Confirm Booking
                        </button>
                        <a asp-page="/Tours/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
