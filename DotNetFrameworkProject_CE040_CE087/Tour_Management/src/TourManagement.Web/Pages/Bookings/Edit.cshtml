@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<h1>Edit Booking</h1>
<hr />

<partial name="_Notifications" />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Booking.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Booking.TourName" class="form-label"></label>
                <input asp-for="Booking.TourName" class="form-control" />
                <span asp-validation-for="Booking.TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Booking.Place" class="form-label"></label>
                <input asp-for="Booking.Place" class="form-control" />
                <span asp-validation-for="Booking.Place" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Booking.Email" class="form-label"></label>
                <input asp-for="Booking.Email" class="form-control" type="email" />
                <span asp-validation-for="Booking.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Booking.FirstName" class="form-label"></label>
                <input asp-for="Booking.FirstName" class="form-control" />
                <span asp-validation-for="Booking.FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
