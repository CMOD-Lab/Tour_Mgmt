@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Booking</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Input.Id" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Input.TourName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.TourName" class="form-control" />
                                <span asp-validation-for="Input.TourName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Place" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Place" class="form-control" />
                                <span asp-validation-for="Input.Place" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.FirstName" class="form-control" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                                <input asp-for="Input.Email" class="form-control" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="Input.IsActive" class="form-check-label fw-semibold">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                            <a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
