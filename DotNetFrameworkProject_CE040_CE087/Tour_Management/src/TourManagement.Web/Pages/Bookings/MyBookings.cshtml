@page
@model TourManagement.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>
<hr />

<partial name="_Notifications" />

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to make a booking.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">Cancel</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
