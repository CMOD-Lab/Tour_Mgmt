@page
@model TourManagement.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-calendar-check me-2 text-primary"></i>My Bookings</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Bookings.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="text-muted mt-3">No bookings found</h4>
            <a asp-page="/Tours/Index" class="btn btn-primary mt-2">
                <i class="bi bi-map me-2"></i>Browse Tours
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model.Bookings)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-light">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-airplane me-2 text-primary"></i>@booking.TourName
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Destination</dt>
                                <dd class="col-sm-7">@booking.Place</dd>
                                <dt class="col-sm-5">Booked By</dt>
                                <dd class="col-sm-7">@booking.FirstName</dd>
                                <dt class="col-sm-5">Email</dt>
                                <dd class="col-sm-7">@booking.Email</dd>
                                <dt class="col-sm-5">Booking Date</dt>
                                <dd class="col-sm-7">@booking.BookingDate.ToString("dd MMM yyyy")</dd>
                            </dl>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="d-flex gap-2">
                                <a asp-page="Details" asp-route-id="@booking.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                                <a asp-page="Delete" asp-route-id="@booking.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3 text-muted small">Total: @Model.Bookings.Count() booking(s)</div>
    }
</div>
