@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your next adventure!</p>
    <hr />
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🗺️ Browse Tours</h5>
                    <p class="card-text">Explore our wide selection of tour packages.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">📋 My Bookings</h5>
                    <p class="card-text">View and manage your tour bookings.</p>
                    <a asp-page="/Bookings/MyBookings" class="btn btn-success">My Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">👤 Account</h5>
                    <p class="card-text">Register or login to manage your account.</p>
                    <a asp-page="/Users/Login" class="btn btn-outline-primary">Login</a>
                    <a asp-page="/Users/Register" class="btn btn-outline-success ms-2">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>
