@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Tour Management - Home";
}

<!-- Hero Section -->
<div class="hero-section text-white text-center py-5 mb-5"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 400px; display: flex; align-items: center;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">
            <i class="bi bi-airplane-fill me-3"></i>Tour Management
        </h1>
        <p class="lead mb-4 fs-4">Discover amazing destinations and book your dream tour today</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-page="/Tours/Index" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-map me-2"></i>Browse Tours
            </a>
            <a asp-page="/Users/Register" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-person-plus me-2"></i>Sign Up
            </a>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container mb-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px; font-size: 1.5rem;">
                        <i class="bi bi-map-fill"></i>
                    </div>
                    <h5 class="card-title fw-bold">Explore Destinations</h5>
                    <p class="card-text text-muted">Browse through our curated collection of amazing tour packages to destinations worldwide.</p>
                    <a asp-page="/Tours/Index" class="btn btn-outline-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-success bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px; font-size: 1.5rem;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h5 class="card-title fw-bold">Easy Booking</h5>
                    <p class="card-text text-muted">Book your preferred tour in just a few clicks. Simple, fast, and secure booking process.</p>
                    <a asp-page="/Bookings/Create" class="btn btn-outline-success">Book Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-warning bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 64px; height: 64px; font-size: 1.5rem;">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <h5 class="card-title fw-bold">Manage Profile</h5>
                    <p class="card-text text-muted">Create your account and manage your bookings, profile, and travel history easily.</p>
                    <a asp-page="/Users/Register" class="btn btn-outline-warning">Get Started</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tours Section -->
@if (Model.RecentTours.Any())
{
    <div class="container mb-5">
        <h2 class="text-center mb-4 fw-bold">Featured Tours</h2>
        <div class="row g-4">
            @foreach (var tour in Model.RecentTours)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(tour.Pic))
                        {
                            <img src="/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-tour.jpg'">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@tour.TourName</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@tour.Place
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info text-dark">
                                    <i class="bi bi-calendar3 me-1"></i>@tour.Days Days
                                </span>
                                <span class="fw-bold text-success fs-5">&#8377;@tour.Price.ToString("N0")</span>
                            </div>
                            <p class="card-text small text-muted">@(tour.TourInfo.Length > 100 ? tour.TourInfo[..100] + "..." : tour.TourInfo)</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="d-flex gap-2">
                                <a asp-page="/Tours/Details" asp-route-id="@tour.Id"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                                <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id"
                                   class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-cart-plus me-1"></i>Book
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-page="/Tours/Index" class="btn btn-primary btn-lg">
                <i class="bi bi-grid me-2"></i>View All Tours
            </a>
        </div>
    </div>
}
