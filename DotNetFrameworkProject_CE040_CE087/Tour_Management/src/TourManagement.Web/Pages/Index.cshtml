@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="jumbotron bg-primary text-white rounded p-5 mb-4">
    <h1 class="display-4"><i class="bi bi-airplane-fill me-3"></i>Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your dream vacation today!</p>
    <hr class="my-4 border-light" />
    <p>Browse our collection of carefully curated tours to destinations around the world.</p>
    <a class="btn btn-light btn-lg" asp-page="/Tours/Index" role="button">
        <i class="bi bi-search me-2"></i>Browse Tours
    </a>
    @if (ViewContext.HttpContext.Session.GetString("UserEmail") == null)
    {
        <a class="btn btn-outline-light btn-lg ms-2" asp-page="/Users/Register" role="button">
            <i class="bi bi-person-plus me-2"></i>Register Now
        </a>
    }
</div>

<!-- Featured Tours -->
<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Featured Tours</h2>
    </div>
    @if (Model.FeaturedTours.Any())
    {
        @foreach (var tour in Model.FeaturedTours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">
                            <i class="bi bi-geo-alt me-1"></i>@tour.Place
                        </p>
                        <p class="card-text">
                            <span class="badge bg-info me-2"><i class="bi bi-calendar me-1"></i>@tour.Days Days</span>
                            <span class="badge bg-success"><i class="bi bi-currency-dollar me-1"></i>@tour.Price.ToString("N2")</span>
                        </p>
                        <p class="card-text">@(tour.TourInfo.Length > 100 ? tour.TourInfo[..100] + "..." : tour.TourInfo)</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success btn-sm ms-1">
                            <i class="bi bi-calendar-check me-1"></i>Book Now
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No tours available at the moment. Please check back later.
            </div>
        </div>
    }
</div>

<!-- Stats Section -->
<div class="row text-center mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white p-3">
            <h3>@Model.TotalTours</h3>
            <p class="mb-0"><i class="bi bi-map me-2"></i>Available Tours</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white p-3">
            <h3>@Model.TotalBookings</h3>
            <p class="mb-0"><i class="bi bi-calendar-check me-2"></i>Total Bookings</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white p-3">
            <h3>@Model.TotalUsers</h3>
            <p class="mb-0"><i class="bi bi-people me-2"></i>Registered Users</p>
        </div>
    </div>
</div>
