<?xml version="1.0" encoding="utf-8"?>
<!--
  cr-dotnet-0010: This Web.Release.config transformation file has been superseded by
  environment-variable-based configuration to support cloud-native deployments on AWS.

  MIGRATION GUIDANCE:
  Instead of using Web.config XDT transformations, inject configuration at runtime using:

  1. AWS Systems Manager Parameter Store:
     - Store DB_CONNECTION_STRING under /TourManagement/Production/DB_CONNECTION_STRING
     - Store ADMIN_EMAIL and ADMIN_PASSWORD under /TourManagement/Production/

  2. Environment Variables (ECS Task Definition / Elastic Beanstalk):
     - DB_CONNECTION_STRING  = <RDS Proxy endpoint connection string for production>
     - ADMIN_EMAIL           = <admin email for production environment>
     - ADMIN_PASSWORD        = <admin password for production environment>
     - ASPNETCORE_ENVIRONMENT = Production

  3. The application code reads these environment variables at runtime,
     enabling immutable build artifacts that work across all environments.
     The debug flag is never baked into production artifacts.

  This file is retained for reference but is no longer processed during build.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Production-specific settings are now managed via environment variables. -->
    <!-- The debug attribute is controlled by the runtime environment, not build transforms. -->
  </system.web>
</configuration>
