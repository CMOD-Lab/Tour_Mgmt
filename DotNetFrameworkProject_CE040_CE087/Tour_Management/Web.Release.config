<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Readiness Fix: cr-dotnet-0010 - Web.config Transformations
  Remediation: Replace Web.config transformations with environment-based configuration
  
  This Web.Release.config transformation file is superseded by environment-based configuration.
  Instead of using build-time transformations, use:
  
  1. Environment variables (preferred for cloud):
     - Set TOURDB_CONNECTION_STRING in Azure App Service Configuration or Key Vault reference
     - Set ASPNET_ENVIRONMENT=Production for production deployments
     - Set ADMIN_EMAIL and ADMIN_PASSWORD in Azure App Service Configuration
  
  2. appsettings.{Environment}.json pattern (for ASP.NET Core migration):
     - appsettings.json (base configuration)
     - appsettings.Production.json (production overrides)
  
  This file is retained for backward compatibility but environment variables
  take precedence over all Web.config values at runtime.
  
  Azure App Service Configuration settings to set:
    TOURDB_CONNECTION_STRING = <Azure SQL connection string>
    ADMIN_EMAIL              = <admin email>
    ADMIN_PASSWORD           = <admin password (use Key Vault reference)>
    ASPNET_ENVIRONMENT       = Production
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Remove debug attribute for production - controlled by ASPNET_ENVIRONMENT in cloud -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
  <!--
    Cloud Readiness: For production cloud deployments, set all configuration via
    Azure App Service Application Settings or Azure Key Vault references.
    Do NOT use this transformation file for cloud deployments.
  -->
</configuration>
