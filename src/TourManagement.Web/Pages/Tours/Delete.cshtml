@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

@if (Model.Tour != null)
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🗑️ Delete Tour</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        Are you sure you want to delete this tour? This action cannot be undone.
                    </div>
                    <dl class="row">
                        <dt class="col-sm-4">Tour Name</dt>
                        <dd class="col-sm-8">@Model.Tour.TourName</dd>
                        <dt class="col-sm-4">Place</dt>
                        <dd class="col-sm-8">@Model.Tour.Place</dd>
                        <dt class="col-sm-4">Days</dt>
                        <dd class="col-sm-8">@Model.Tour.Days</dd>
                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">₹@Model.Tour.Price.ToString("N0")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form method="post">
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </form>
                    <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found. <a asp-page="/Tours/Index">Back to tours</a></div>
}
