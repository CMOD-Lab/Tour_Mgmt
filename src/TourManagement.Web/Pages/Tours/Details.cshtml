@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height:300px;">
                    <span class="text-white" style="font-size:5rem;">🌍</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h2>@Model.Tour.TourName</h2>
            <table class="table table-bordered">
                <tr><th>Place</th><td>@Model.Tour.Place</td></tr>
                <tr><th>Duration</th><td>@Model.Tour.Days days</td></tr>
                <tr><th>Price</th><td>₹@Model.Tour.Price.ToString("N2")</td></tr>
                <tr><th>Locations</th><td>@Model.Tour.Locations</td></tr>
            </table>
            <h5>About This Tour</h5>
            <p>@Model.Tour.TourInfo</p>
            <div class="mt-3">
                <a asp-page="/Bookings/Create"
                   asp-route-tourId="@Model.Tour.TourId"
                   asp-route-tourName="@Model.Tour.TourName"
                   asp-route-place="@Model.Tour.Place"
                   class="btn btn-primary btn-lg">Book This Tour</a>
                <a asp-page="/Tours/Index" class="btn btn-secondary ms-2">Back to Tours</a>
                @if (HttpContext.Session.GetString("IsAdmin") == "true")
                {
                    <a asp-page="/Tours/Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning ms-2">Edit</a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found. <a asp-page="/Tours/Index">Back to Tours</a></div>
}
