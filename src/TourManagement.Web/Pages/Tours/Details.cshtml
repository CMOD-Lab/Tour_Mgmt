@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
            }
        </div>
        <div class="col-md-6">
            <h2>@Model.Tour.TourName</h2>
            <table class="table table-bordered mt-3">
                <tr><th>Place</th><td>@Model.Tour.Place</td></tr>
                <tr><th>Duration</th><td>@Model.Tour.Days days</td></tr>
                <tr><th>Price</th><td>₹@Model.Tour.Price</td></tr>
                <tr><th>Locations</th><td>@Model.Tour.Locations</td></tr>
                <tr><th>Tour Info</th><td>@Model.Tour.TourInfo</td></tr>
            </table>
            <div class="mt-3">
                @if (Model.IsUserLoggedIn)
                {
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book This Tour</a>
                }
                else
                {
                    <a asp-page="/Users/Login" class="btn btn-primary">Login to Book</a>
                }
                <a asp-page="./Index" class="btn btn-secondary ms-2">Back to Tours</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
