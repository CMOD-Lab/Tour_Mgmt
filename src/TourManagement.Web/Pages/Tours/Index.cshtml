@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🗺️ Available Tours</h2>
    @if (HttpContext.Session.GetString("IsAdmin") == "true")
    {
        <a asp-page="/Tours/Create" class="btn btn-success">+ Add New Tour</a>
    }
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name or place..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="/Tours/Index" class="btn btn-secondary">Clear</a>
        }
    </div>
</form>

@if (Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-white fs-1">🌍</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text">@tour.TourInfo</p>
                        <ul class="list-unstyled">
                            <li>⏱️ <strong>@tour.Days days</strong></li>
                            <li>💰 <strong>₹@tour.Price.ToString("N0")</strong></li>
                            <li>🗺️ @tour.Locations</li>
                        </ul>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        @if (HttpContext.Session.GetString("UserEmail") != null)
                        {
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                        }
                        @if (HttpContext.Session.GetString("IsAdmin") == "true")
                        {
                            <a asp-page="/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="/Tours/Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span>No tours found matching "<strong>@Model.SearchTerm</strong>".</span>
        }
        else
        {
            <span>No tours available at the moment.</span>
        }
    </div>
}
