@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p>Search results for: <strong>@Model.SearchTerm</strong> <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Clear</a></p>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name, place, or location..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text">@tour.TourInfo</p>
                        <ul class="list-unstyled">
                            <li>⏱️ <strong>@tour.Days days</strong></li>
                            <li>💰 <strong>₹@tour.Price</strong></li>
                            <li>🗺️ @tour.Locations</li>
                        </ul>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        @if (Model.IsUserLoggedIn)
                        {
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                        }
                        @if (Model.IsAdmin)
                        {
                            <a asp-page="./Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No tours found.</div>
}

@if (Model.IsAdmin)
{
    <a asp-page="./Create" class="btn btn-primary mt-3">Add New Tour</a>
}
