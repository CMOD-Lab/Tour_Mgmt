@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🌍 Available Tours</h2>
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search tours..." />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="/Tours/Index" class="btn btn-outline-secondary">Clear</a>
        }
    </form>
</div>

@if (Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-white fs-1">🏖️</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">📍 @tour.Place</p>
                        <p class="card-text small">@tour.TourInfo</p>
                        <p class="card-text small text-muted">🗺️ @tour.Locations</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info">@tour.Days Days</span>
                            <strong class="text-success fs-5">₹@tour.Price.ToString("N0")</strong>
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm flex-fill">Details</a>
                        @if (HttpContext.Session.GetString("UserEmail") != null)
                        {
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm flex-fill">Book Now</a>
                        }
                        else
                        {
                            <a asp-page="/Account/Login" class="btn btn-outline-success btn-sm flex-fill">Login to Book</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span>No tours found matching "<strong>@Model.SearchTerm</strong>". <a asp-page="/Tours/Index">View all tours</a>.</span>
        }
        else
        {
            <span>No tours are currently available. Please check back later.</span>
        }
    </div>
}
