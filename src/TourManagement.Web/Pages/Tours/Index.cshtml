@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Available Tours</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Tour
        </a>
    }
</div>

<div class="mb-3">
    <form method="get" class="d-flex">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control me-2" placeholder="Search tours by name or place..." />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="Index" class="btn btn-outline-secondary ms-2">Clear</a>
        }
    </form>
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No tours found. @(string.IsNullOrEmpty(Model.SearchTerm) ? "Check back later for new tours!" : "Try a different search term.")
    </div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" onerror="this.src='/images/no-image.jpg'" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-white fs-1"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <i class="bi bi-geo-alt text-danger"></i> @tour.Place<br />
                            <i class="bi bi-calendar3 text-primary"></i> @tour.Days days<br />
                            <i class="bi bi-currency-dollar text-success"></i> @tour.Price.ToString("C")
                        </p>
                        <p class="text-muted small">@tour.Locations</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a asp-page="Details" asp-route-id="@tour.TourId" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" asp-route-tourName="@tour.TourName" class="btn btn-sm btn-success">Book Now</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@tour.TourId" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
