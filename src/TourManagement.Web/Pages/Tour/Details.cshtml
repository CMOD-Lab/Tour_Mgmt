@page "{id:int}"
@model TourManagement.Web.Pages.Tour.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">@Model.Tour.TourName</h3>
                </div>
                @if (!string.IsNullOrEmpty(Model.Tour.Pic))
                {
                    <img src="~/images/tours/@Model.Tour.Pic" class="card-img-top" alt="@Model.Tour.TourName" style="max-height:400px;object-fit:cover;" />
                }
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Tour Information</h5>
                            <dl>
                                <dt>Destination</dt>
                                <dd>📍 @Model.Tour.Place</dd>
                                <dt>Duration</dt>
                                <dd>⏱️ @Model.Tour.Days days</dd>
                                <dt>Price</dt>
                                <dd>💰 @Model.Tour.PriceFormatted</dd>
                                <dt>Locations Covered</dt>
                                <dd>🗺️ @Model.Tour.Locations</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5>About This Tour</h5>
                            <p>@Model.Tour.TourInfo</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-page="/Tour/Index" class="btn btn-secondary">Back to Tours</a>
                    @if (HttpContext.Session.GetString("UserEmail") != null)
                    {
                        <a asp-page="/Booking/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-primary">Book This Tour</a>
                    }
                    else
                    {
                        <a asp-page="/User/Login" class="btn btn-primary">Login to Book</a>
                    }
                    @if (HttpContext.Session.GetString("IsAdmin") == "true")
                    {
                        <a asp-page="/Tour/Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">Edit</a>
                        <a asp-page="/Tour/Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger">Delete</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tour/Index" class="btn btn-secondary">Back to Tours</a>
}
