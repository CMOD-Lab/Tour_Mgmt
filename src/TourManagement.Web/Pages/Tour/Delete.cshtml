@page "{id:int}"
@model TourManagement.Web.Pages.Tour.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Tour</h4>
            </div>
            <div class="card-body">
                @if (Model.Tour != null)
                {
                    <div class="alert alert-warning">
                        <strong>Are you sure you want to delete this tour?</strong>
                        <p>This action cannot be undone.</p>
                    </div>
                    <dl>
                        <dt>Tour Name</dt>
                        <dd>@Model.Tour.TourName</dd>
                        <dt>Place</dt>
                        <dd>@Model.Tour.Place</dd>
                        <dt>Days</dt>
                        <dd>@Model.Tour.Days</dd>
                        <dt>Price</dt>
                        <dd>@Model.Tour.PriceFormatted</dd>
                    </dl>
                    <form method="post">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                            <a asp-page="/Tour/Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">Tour not found.</div>
                    <a asp-page="/Tour/Index" class="btn btn-secondary">Back to Tours</a>
                }
            </div>
        </div>
    </div>
</div>
