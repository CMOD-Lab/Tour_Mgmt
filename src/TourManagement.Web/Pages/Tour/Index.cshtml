@page
@model TourManagement.Web.Pages.Tour.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Available Tours</h2>
    @if (HttpContext.Session.GetString("IsAdmin") == "true")
    {
        <a asp-page="/Tour/Create" class="btn btn-success">+ Add New Tour</a>
    }
</div>

<div class="mb-3">
    <form method="get">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name or place..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            <a asp-page="/Tour/Index" class="btn btn-outline-danger">Clear</a>
        </div>
    </form>
</div>

<div class="row">
    @foreach (var tour in Model.Tours)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow">
                @if (!string.IsNullOrEmpty(tour.Pic))
                {
                    <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                        <span class="text-white fs-1">✈️</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@tour.TourName</h5>
                    <p class="card-text text-muted">📍 @tour.Place</p>
                    <p class="card-text">@tour.TourInfo</p>
                    <ul class="list-unstyled">
                        <li>⏱️ <strong>Duration:</strong> @tour.Days days</li>
                        <li>💰 <strong>Price:</strong> @tour.PriceFormatted</li>
                        <li>🗺️ <strong>Locations:</strong> @tour.Locations</li>
                    </ul>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-page="/Tour/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                    @if (HttpContext.Session.GetString("UserEmail") != null)
                    {
                        <a asp-page="/Booking/Create" asp-route-tourId="@tour.TourId" class="btn btn-primary btn-sm">Book Now</a>
                    }
                    @if (HttpContext.Session.GetString("IsAdmin") == "true")
                    {
                        <a asp-page="/Tour/Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="/Tour/Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours available at the moment.</div>
}
