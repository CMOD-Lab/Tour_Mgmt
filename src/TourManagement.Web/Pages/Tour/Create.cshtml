@page
@model TourManagement.Web.Pages.Tour.CreateModel
@{
    ViewData["Title"] = "Add New Tour";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Add New Tour</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.TourName" class="form-label"></label>
                            <input asp-for="Input.TourName" class="form-control" placeholder="Tour name (max 20 chars)" />
                            <span asp-validation-for="Input.TourName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Place" class="form-label"></label>
                            <input asp-for="Input.Place" class="form-control" placeholder="Destination (max 20 chars)" />
                            <span asp-validation-for="Input.Place" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Days" class="form-label"></label>
                            <input asp-for="Input.Days" class="form-control" type="number" min="1" max="99" />
                            <span asp-validation-for="Input.Days" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <input asp-for="Input.Price" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Input.Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Locations" class="form-label"></label>
                        <input asp-for="Input.Locations" class="form-control" placeholder="Locations covered (max 100 chars)" />
                        <span asp-validation-for="Input.Locations" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.TourInfo" class="form-label"></label>
                        <textarea asp-for="Input.TourInfo" class="form-control" rows="3" placeholder="Tour description (max 200 chars)"></textarea>
                        <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.PicFile" class="form-label"></label>
                        <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="Input.PicFile" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Add Tour</button>
                        <a asp-page="/Tour/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
