@page
@model TourManagement.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "All Users";
}

<h2>All Users</h2>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Gender</th>
            <th>City</th>
            <th>State</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Gender</td>
                <td>@user.City</td>
                <td>@user.State</td>
                <td>@(user.IsActive ? "✅" : "❌")</td>
                <td>
                    <a asp-page="./Edit" asp-route-email="@user.Email" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="./Delete" asp-route-email="@user.Email" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
