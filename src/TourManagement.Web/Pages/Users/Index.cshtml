@page
@model TourManagement.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "All Users";
}

<h2>All Users</h2>
@if (Model.Users.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Gender</th>
                <th>City</th>
                <th>State</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Gender</td>
                    <td>@user.City</td>
                    <td>@user.State</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-email="@user.Email"
                              onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No users found.</div>
}
