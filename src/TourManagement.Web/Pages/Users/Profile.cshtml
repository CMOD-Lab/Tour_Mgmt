@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>
<hr />

@if (Model.Profile != null)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Profile.FirstName @Model.Profile.LastName</h5>
                    <div class="row mb-2">
                        <div class="col-sm-4"><strong>Email:</strong></div>
                        <div class="col-sm-8">@Model.Profile.Email</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4"><strong>Gender:</strong></div>
                        <div class="col-sm-8">@Model.Profile.Gender</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4"><strong>Date of Birth:</strong></div>
                        <div class="col-sm-8">@Model.Profile.DateOfBirth.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4"><strong>Address:</strong></div>
                        <div class="col-sm-8">@Model.Profile.Street, @Model.Profile.City, @Model.Profile.State</div>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <a asp-page="Edit" class="btn btn-warning">Edit Profile</a>
                <a asp-page="/Bookings/Index" class="btn btn-info ms-2 text-white">My Bookings</a>
            </div>
        </div>
    </div>
}
