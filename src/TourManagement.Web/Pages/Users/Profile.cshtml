@page
@model TourManagement.Web.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@if (Model.User != null)
{
    <h2>My Profile</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.User.FirstName @Model.User.LastName</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.User.Email</dd>
                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.User.Gender</dd>
                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.User.Dob.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.User.Street, @Model.User.City, @Model.User.State</dd>
                    </dl>
                    <a asp-page="./Edit" asp-route-email="@Model.User.Email" class="btn btn-warning">Edit Profile</a>
                    <a asp-page="/Bookings/MyBookings" class="btn btn-info ms-2">My Bookings</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Please login to view your profile.</div>
    <a asp-page="./Login" class="btn btn-primary">Login</a>
}
