@page "{email}"
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<h2>Delete User</h2>
<div class="alert alert-danger">Are you sure you want to delete this user?</div>

@if (Model.User != null)
{
    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.User.Email</dd>
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.User.FirstName @Model.User.LastName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="User.Email" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
}
