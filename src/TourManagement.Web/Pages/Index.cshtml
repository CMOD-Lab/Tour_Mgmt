@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron text-center py-5 bg-primary text-white rounded">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your dream vacation today!</p>
    <hr class="my-4" />
    <a class="btn btn-light btn-lg" asp-page="/Tour/Index">Browse Tours</a>
    @if (HttpContext.Session.GetString("UserEmail") == null)
    {
        <a class="btn btn-outline-light btn-lg ms-2" asp-page="/User/Register">Register Now</a>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h3 class="card-title">🌍 Explore Destinations</h3>
                <p class="card-text">Browse our wide selection of tour packages to amazing destinations around the world.</p>
                <a asp-page="/Tour/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h3 class="card-title">📅 Easy Booking</h3>
                <p class="card-text">Book your tour in just a few clicks. Simple, fast, and secure booking process.</p>
                <a asp-page="/User/Login" class="btn btn-primary">Book Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="card h-100 shadow">
            <div class="card-body">
                <h3 class="card-title">✈️ Travel with Confidence</h3>
                <p class="card-text">Manage your bookings, view tour details, and plan your perfect trip.</p>
                <a asp-page="/User/Register" class="btn btn-primary">Get Started</a>
            </div>
        </div>
    </div>
</div>
