@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Tour Management - Home";
}

<div class="jumbotron text-center py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px;">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Find the best tour packages without any hassle. Book and pack your luggage!</p>
    <hr class="my-4" style="border-color: rgba(255,255,255,0.3);">
    <a class="btn btn-light btn-lg me-2" asp-page="/Tours/Index">Explore Tours</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-outline-light btn-lg" asp-page="/Bookings/Index">My Bookings</a>
    }
    else
    {
        <a class="btn btn-outline-light btn-lg" asp-page="/Users/Login">Login / Register</a>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-map fs-1 text-primary"></i>
                <h5 class="card-title mt-3">Explore Destinations</h5>
                <p class="card-text">Browse through our wide selection of tour packages to amazing destinations.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-calendar-check fs-1 text-success"></i>
                <h5 class="card-title mt-3">Easy Booking</h5>
                <p class="card-text">Book your dream tour in just a few clicks. Simple and hassle-free process.</p>
                <a asp-page="/Users/Login" class="btn btn-success">Book Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-person-circle fs-1 text-info"></i>
                <h5 class="card-title mt-3">Manage Profile</h5>
                <p class="card-text">Create your account and manage your bookings and personal information.</p>
                <a asp-page="/Users/Register" class="btn btn-info text-white">Sign Up</a>
            </div>
        </div>
    </div>
</div>
