@page
@model TourManagement.Web.Pages.Booking.CreateModel
@{
    ViewData["Title"] = "Book Tour";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Book a Tour</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                @if (Model.SelectedTour != null)
                {
                    <div class="alert alert-info">
                        <strong>Selected Tour:</strong> @Model.SelectedTour.TourName - @Model.SelectedTour.Place
                        (@Model.SelectedTour.Days days, @Model.SelectedTour.PriceFormatted)
                    </div>
                }
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" readonly />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" readonly />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Confirm Booking</button>
                        <a asp-page="/Tour/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
