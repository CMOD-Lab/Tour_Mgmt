@page
@model TourManagement.Web.Pages.Booking.AllBookingsModel
@{
    ViewData["Title"] = "All Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>All Bookings</h2>
</div>

<div class="mb-3">
    <form method="get">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search bookings..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            <a asp-page="/Booking/AllBookings" class="btn btn-outline-danger">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Customer Email</th>
                <th>Customer Name</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.Email</td>
                    <td>@booking.FirstName</td>
                    <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" style="display:inline;">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this booking?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
