@page
@model TourManagement.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "All Bookings";
}

<h2>All Bookings</h2>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tour Name</th>
            <th>Place</th>
            <th>Email</th>
            <th>First Name</th>
            <th>Date</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model.Bookings)
        {
            <tr>
                <td>@booking.BookingId</td>
                <td>@booking.TourName</td>
                <td>@booking.Place</td>
                <td>@booking.Email</td>
                <td>@booking.FirstName</td>
                <td>@booking.CreatedDate.ToString("dd MMM yyyy")</td>
                <td>@(booking.IsActive ? "✅" : "❌")</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@booking.BookingId" class="btn btn-info btn-sm">Details</a>
                    <a asp-page="./Delete" asp-route-id="@booking.BookingId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
