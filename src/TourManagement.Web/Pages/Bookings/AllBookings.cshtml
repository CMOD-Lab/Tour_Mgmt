@page
@model TourManagement.Web.Pages.Bookings.AllBookingsModel
@{
    ViewData["Title"] = "All Bookings";
}

<h2>📋 All Bookings</h2>

@if (Model.Bookings.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Customer Email</th>
                <th>Customer Name</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.Email</td>
                    <td>@booking.FirstName</td>
                    <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@booking.BookingId"
                              onsubmit="return confirm('Are you sure you want to delete this booking?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No bookings found.</div>
}
