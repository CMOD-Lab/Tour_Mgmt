@page
@model TourManagement.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Bookings</h2>
    <a asp-page="/Bookings/Create" class="btn btn-primary">+ New Booking</a>
</div>

@if (Model.Bookings.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.FirstName</td>
                        <td>
                            <a asp-page="/Bookings/Details" asp-route-id="@booking.BookingId" class="btn btn-info btn-sm">Details</a>
                            <a asp-page="/Bookings/Delete" asp-route-id="@booking.BookingId" class="btn btn-danger btn-sm ms-1">Cancel</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to make your first booking!
    </div>
}
