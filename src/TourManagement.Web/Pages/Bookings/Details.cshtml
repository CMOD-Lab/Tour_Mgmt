@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Booking Details</h4>
            </div>
            <div class="card-body">
                @if (Model.Booking != null)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Booking ID</dt>
                        <dd class="col-sm-8">@Model.Booking.BookingId</dd>
                        <dt class="col-sm-4">Tour Name</dt>
                        <dd class="col-sm-8">@Model.Booking.TourName</dd>
                        <dt class="col-sm-4">Place</dt>
                        <dd class="col-sm-8">@Model.Booking.Place</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Booking.Email</dd>
                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Model.Booking.FirstName</dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-page="/Bookings/MyBookings" class="btn btn-secondary">Back to My Bookings</a>
                        <a asp-page="/Bookings/Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger ms-2">Cancel Booking</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">Booking not found.</div>
                }
            </div>
        </div>
    </div>
</div>
