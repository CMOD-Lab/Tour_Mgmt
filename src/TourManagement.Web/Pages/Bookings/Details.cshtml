@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<hr />

@if (Model.Booking != null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Booking #@Model.Booking.BookingId</h5>
            <div class="row mb-2">
                <div class="col-sm-4"><strong>Tour Name:</strong></div>
                <div class="col-sm-8">@Model.Booking.TourName</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4"><strong>Place:</strong></div>
                <div class="col-sm-8">@Model.Booking.Place</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4"><strong>Name:</strong></div>
                <div class="col-sm-8">@Model.Booking.FirstName</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4"><strong>Email:</strong></div>
                <div class="col-sm-8">@Model.Booking.Email</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4"><strong>Booking Date:</strong></div>
                <div class="col-sm-8">@Model.Booking.BookingDate.ToString("MMMM dd, yyyy HH:mm")</div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">Back to Bookings</a>
        <a asp-page="Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger ms-2">Cancel Booking</a>
    </div>
}
else
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="Index" class="btn btn-secondary">Back to Bookings</a>
}
