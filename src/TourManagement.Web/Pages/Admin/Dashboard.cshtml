@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TourCount</h3>
                <p>Total Tours</p>
                <a asp-page="/Tours/Index" class="btn btn-light btn-sm">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.UserCount</h3>
                <p>Registered Users</p>
                <a asp-page="/Users/Index" class="btn btn-light btn-sm">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.BookingCount</h3>
                <p>Total Bookings</p>
                <a asp-page="/Bookings/Index" class="btn btn-light btn-sm">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body text-center">
                <h3>+</h3>
                <p>Add New Tour</p>
                <a asp-page="/Tours/Create" class="btn btn-dark btn-sm">Add Tour</a>
            </div>
        </div>
    </div>
</div>
