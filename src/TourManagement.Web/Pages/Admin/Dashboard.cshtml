@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Admin Dashboard</h2>
    <span class="badge bg-danger fs-6">Admin Panel</span>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalTours</h3>
                <p class="mb-0">Total Tours</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalUsers</h3>
                <p class="mb-0">Registered Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalBookings</h3>
                <p class="mb-0">Total Bookings</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Tour/Create" class="btn btn-success">+ Add New Tour</a>
                    <a asp-page="/Tour/Index" class="btn btn-primary">Manage Tours</a>
                    <a asp-page="/Booking/AllBookings" class="btn btn-info">View All Bookings</a>
                    <a asp-page="/User/Index" class="btn btn-warning">Manage Users</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Recent Bookings</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentBookings.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Tour</th>
                                <th>Customer</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td>@booking.TourName</td>
                                    <td>@booking.FirstName</td>
                                    <td>@booking.BookingDate.ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No recent bookings.</p>
                }
            </div>
        </div>
    </div>
</div>
