@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>🛠️ Admin Dashboard</h2>

<div class="row mt-4">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h1>@Model.TotalTours</h1>
                <p class="mb-0">Total Tours</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Tours/Index" class="text-white">Manage Tours →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h1>@Model.TotalBookings</h1>
                <p class="mb-0">Total Bookings</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Bookings/AllBookings" class="text-white">View Bookings →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body text-center">
                <h1>@Model.TotalUsers</h1>
                <p class="mb-0">Registered Users</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Users/Index" class="text-white">Manage Users →</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card bg-warning shadow">
            <div class="card-body text-center">
                <h1>➕</h1>
                <p class="mb-0">Add New Tour</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Tours/Create" class="text-dark">Add Tour →</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">Quick Actions</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Tours/Create" class="btn btn-success">➕ Add New Tour</a>
                    <a asp-page="/Bookings/AllBookings" class="btn btn-primary">📋 View All Bookings</a>
                    <a asp-page="/Users/Index" class="btn btn-info">👥 Manage Users</a>
                    <a asp-page="/Tours/Index" class="btn btn-secondary">🗺️ View All Tours</a>
                </div>
            </div>
        </div>
    </div>
</div>
