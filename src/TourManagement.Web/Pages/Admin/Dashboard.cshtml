@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>🛠️ Admin Dashboard</h2>
<p class="text-muted">Welcome to the Tour Management Admin Panel.</p>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card bg-primary text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalTours</h3>
                <p class="mb-0">Total Tours</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Admin/Tours/Index" class="text-white">Manage Tours →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalUsers</h3>
                <p class="mb-0">Registered Users</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Admin/Users/Index" class="text-white">Manage Users →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-info text-white shadow">
            <div class="card-body text-center">
                <h3>@Model.TotalBookings</h3>
                <p class="mb-0">Total Bookings</p>
            </div>
            <div class="card-footer text-center">
                <a asp-page="/Admin/Bookings/Index" class="text-white">View Bookings →</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-page="/Admin/Tours/Create" class="btn btn-primary me-2">➕ Add New Tour</a>
    <a asp-page="/Tours/Index" class="btn btn-outline-secondary">View Public Tours</a>
</div>
