@page "{id:int}"
@model TourManagement.Web.Pages.Admin.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-page="/Admin/Tours/Index">Tours</a></li>
        <li class="breadcrumb-item active">Edit Tour</li>
    </ol>
</nav>

<div class="card shadow">
    <div class="card-header bg-warning">
        <h4 class="mb-0">✏️ Edit Tour</h4>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Input.TourId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.TourName" class="form-label"></label>
                    <input asp-for="Input.TourName" class="form-control" />
                    <span asp-validation-for="Input.TourName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Place" class="form-label"></label>
                    <input asp-for="Input.Place" class="form-control" />
                    <span asp-validation-for="Input.Place" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Days" class="form-label"></label>
                    <input asp-for="Input.Days" class="form-control" type="number" min="1" max="99" />
                    <span asp-validation-for="Input.Days" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Price" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="Input.Price" class="form-control" type="number" min="1" step="0.01" />
                    </div>
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Locations" class="form-label"></label>
                <input asp-for="Input.Locations" class="form-control" />
                <span asp-validation-for="Input.Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TourInfo" class="form-label"></label>
                <textarea asp-for="Input.TourInfo" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Input.CurrentPic))
            {
                <div class="mb-3">
                    <label class="form-label">Current Picture</label>
                    <div>
                        <img src="~/images/tours/@Model.Input.CurrentPic" alt="Current tour picture" style="max-height:150px;" class="img-thumbnail" onerror="this.style.display='none'" />
                    </div>
                    <input type="hidden" asp-for="Input.CurrentPic" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.PicFile" class="form-label"></label>
                <input asp-for="Input.PicFile" class="form-control" type="file" accept="image/*" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="Input.IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Update Tour</button>
                <a asp-page="/Admin/Tours/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
