@page
@model TourManagement.Web.Pages.Admin.Tours.IndexModel
@{
    ViewData["Title"] = "Manage Tours";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🌍 Manage Tours</h2>
    <a asp-page="/Admin/Tours/Create" class="btn btn-primary">➕ Add New Tour</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Tours.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Days</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tour in Model.Tours)
                {
                    <tr>
                        <td>@tour.TourId</td>
                        <td>@tour.TourName</td>
                        <td>@tour.Place</td>
                        <td>@tour.Days</td>
                        <td>₹@tour.Price.ToString("N0")</td>
                        <td>
                            @if (tour.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Admin/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">View</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@tour.TourId" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this tour?');">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No tours found. <a asp-page="/Admin/Tours/Create">Add the first tour</a>.</div>
}
