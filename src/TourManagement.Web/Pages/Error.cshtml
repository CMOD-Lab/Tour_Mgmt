@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger">⚠️</h1>
    <h2>An Error Occurred</h2>
    <p class="text-muted">We're sorry, something went wrong. Please try again later.</p>
    @if (Model.RequestId != null)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-3">Go to Home</a>
</div>
