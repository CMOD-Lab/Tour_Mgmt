@page
@model TourManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-1 text-danger">⚠️</h1>
        <h2>An Error Occurred</h2>
        <p class="text-muted">Sorry, something went wrong. Please try again later.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-page="/Index" class="btn btn-primary mt-3">Go Home</a>
    </div>
</div>
