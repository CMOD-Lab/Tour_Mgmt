@page
@model TourManagement.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">👤 My Profile</h4>
            </div>
            <div class="card-body">
                @if (Model.Profile != null)
                {
                    <dl class="row">
                        <dt class="col-sm-3">Full Name</dt>
                        <dd class="col-sm-9">@Model.Profile.FullName</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Profile.Email</dd>

                        <dt class="col-sm-3">Gender</dt>
                        <dd class="col-sm-9">@Model.Profile.Gender</dd>

                        <dt class="col-sm-3">Date of Birth</dt>
                        <dd class="col-sm-9">@Model.Profile.Dob.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@Model.Profile.Street, @Model.Profile.City, @Model.Profile.State</dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-page="/Tours/Index" class="btn btn-primary">Browse Tours</a>
                        <a asp-page="/Bookings/MyBookings" class="btn btn-outline-secondary ms-2">My Bookings</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">Profile not found. Please <a asp-page="/Account/Login">login</a> again.</div>
                }
            </div>
        </div>
    </div>
</div>
