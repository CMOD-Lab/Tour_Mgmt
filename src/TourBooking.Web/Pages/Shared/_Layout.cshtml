<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Booking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <i class="bi bi-airplane"></i> Tour Booking
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Tours/Index">Tours</a>
                    </li>
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/MyBookings">My Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Profile">Profile</a>
                        </li>
                    }
                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Admin/Tours">Manage Tours</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Users">Manage Users</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Bookings">All Bookings</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">Welcome, @Context.Session.GetString("UserEmail")</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Users/Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-5 py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year Tour Booking System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
