@page
@model TourBooking.Web.Pages.Admin.ToursModel
@{
    ViewData["Title"] = "Manage Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Tours</h2>
    <a asp-page="/Admin/CreateTour" class="btn btn-success">Add New Tour</a>
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Days</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tour in Model.Tours)
                {
                    <tr>
                        <td>@tour.TourId</td>
                        <td>@tour.TourName</td>
                        <td>@tour.Place</td>
                        <td>@tour.Days</td>
                        <td>₹@tour.Price</td>
                        <td>
                            <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">View</a>
                            <a asp-page="/Admin/EditTour" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="/Admin/DeleteTour" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
