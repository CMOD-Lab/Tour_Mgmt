@page
@model TourBooking.Web.Pages.Admin.BookingsModel
@{
    ViewData["Title"] = "All Bookings";
}

<h2>All Bookings</h2>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.TourId</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.Email</td>
                        <td>@booking.FirstName</td>
                        <td>
                            <a asp-page="/Bookings/Details" asp-route-id="@booking.TourId" class="btn btn-info btn-sm">View</a>
                            <a asp-page="/Bookings/Delete" asp-route-id="@booking.TourId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
