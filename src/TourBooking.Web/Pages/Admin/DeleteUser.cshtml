@page "{email}"
@model TourBooking.Web.Pages.Admin.DeleteUserModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete User</h4>
            </div>
            <div class="card-body">
                @if (Model.UserProfile != null)
                {
                    <p class="text-danger">Are you sure you want to delete this user?</p>
                    <table class="table table-bordered">
                        <tr>
                            <th>Email</th>
                            <td>@Model.UserProfile.Email</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.UserProfile.FirstName @Model.UserProfile.LastName</td>
                        </tr>
                    </table>
                    <form method="post">
                        <button type="submit" class="btn btn-danger">Yes, Delete User</button>
                        <a asp-page="/Admin/Users" class="btn btn-secondary">Cancel</a>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">User not found.</div>
                    <a asp-page="/Admin/Users" class="btn btn-secondary">Back to Users</a>
                }
            </div>
        </div>
    </div>
</div>
