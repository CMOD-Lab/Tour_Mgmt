@page
@model TourBooking.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book a Tour";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Book a Tour</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label"></label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Place" class="form-label"></label>
                        <input asp-for="Input.Place" class="form-control" />
                        <span asp-validation-for="Input.Place" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Confirm Booking</button>
                    </div>
                </form>
                <hr />
                <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
