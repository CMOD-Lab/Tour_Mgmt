@page "{id:int}"
@model TourBooking.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@Model.Tour.TourName</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Tour.Pic))
                    {
                        <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid mb-3 rounded" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    <table class="table table-bordered">
                        <tr>
                            <th>Place</th>
                            <td>@Model.Tour.Place</td>
                        </tr>
                        <tr>
                            <th>Duration</th>
                            <td>@Model.Tour.Days days</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>₹@Model.Tour.Price</td>
                        </tr>
                        <tr>
                            <th>Locations</th>
                            <td>@Model.Tour.Locations</td>
                        </tr>
                        <tr>
                            <th>Tour Info</th>
                            <td>@Model.Tour.TourInfo</td>
                        </tr>
                    </table>
                    <div class="mt-3">
                        <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book This Tour</a>
                        <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
}
