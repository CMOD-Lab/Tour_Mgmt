@page
@model TourBooking.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<h2>Available Tours</h2>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p>Search results for: <strong>@Model.SearchTerm</strong></p>
}

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name or place..." />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="/Tours/Index" class="btn btn-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found.</div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/tours/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px;object-fit:cover;" onerror="this.src='/images/default-tour.jpg'" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text text-muted">@tour.Place</p>
                        <p class="card-text">@tour.TourInfo</p>
                        <ul class="list-unstyled">
                            <li><strong>Days:</strong> @tour.Days</li>
                            <li><strong>Price:</strong> ₹@tour.Price</li>
                            <li><strong>Locations:</strong> @tour.Locations</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
